# ============================================================
# 15. CHECK FOR PHYSICIAN QUARTER GAPS
# ============================================================

df["previous_quarter_index"] = (
    df.groupby("physician_id")
    ["quarter_index"]
    .shift(1)
)

df["quarter_gap"] = (
    df["quarter_index"]
    - df["previous_quarter_index"]
)

df["has_gap"] = (
    df["quarter_gap"] > 1
)

gap_summary = (
    df.groupby("physician_id")
    .agg(
        quarters_observed=(
            "quarter_index",
            "nunique"
        ),
        number_of_gaps=(
            "has_gap",
            "sum"
        ),
        first_quarter=(
            "quarter_index",
            "min"
        ),
        last_quarter=(
            "quarter_index",
            "max"
        )
    )
    .reset_index()
)

gap_summary["has_any_gap"] = (
    gap_summary["number_of_gaps"] > 0
)

print("\n" + "=" * 80)
print("PHYSICIAN QUARTER GAP ANALYSIS")
print("=" * 80)

print(
    "Physicians with at least one quarter gap:",
    gap_summary["has_any_gap"].sum()
)

print(
    "Physicians with no quarter gaps:",
    (~gap_summary["has_any_gap"]).sum()
)

print(
    "Percentage with gaps:",
    round(
        gap_summary["has_any_gap"].mean() * 100,
        2
    ),
    "%"
)

print("\nGap distribution:")
print(
    gap_summary["number_of_gaps"]
    .value_counts()
    .sort_index()
)

# Show physicians with gaps
