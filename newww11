    .to_string(index=False)
)

# ============================================================
# 27. PHYSICIAN ADOPTION TRANSITIONS
# ============================================================
# This is useful before building the lag model.
# It tells us how often physicians move from
# non-adopter -> adopter.

df["previous_brand_prescribed"] = (
    df.groupby("physician_id")
    [TARGET]
    .shift(1)
)

transition_data = df[
    df["previous_brand_prescribed"].notna()
].copy()

transition_data["transition"] = (
    transition_data[
        "previous_brand_prescribed"
    ].astype(int).astype(str)
    + " -> "
    + transition_data[TARGET]
    .astype(int).astype(str)
)

transition_summary = (
    transition_data["transition"]
    .value_counts()
    .reset_index()
)

transition_summary.columns = [
    "transition",
    "count"
]

transition_summary["percentage"] = (
    transition_summary["count"]
    / transition_summary["count"].sum()
    * 100
)

print("\n" + "=" * 80)
print("PHYSICIAN ADOPTION TRANSITIONS")
