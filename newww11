# ============================================================
# 14. PHYSICIAN COVERAGE BY QUARTER
# ============================================================

physician_quarter = (
    df.groupby("year_quarter")
    .agg(
        unique_physicians=(
            "physician_id",
            "nunique"
        ),
        observations=(TARGET, "count")
