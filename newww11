# ============================================================
# BASIC + ADVANCED EDA
# FILE 1 = PHYSICIAN-QUARTER BEHAVIOR
# FILE 2 = STATIC PHYSICIAN PROFILE
# ============================================================

import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# ============================================================
# 1. LOAD BOTH FILES
# ============================================================

FILE1 = "Input_data_file1.csv"
FILE2 = "Input_data_file2.csv"

df1 = pd.read_csv(FILE1)
df2 = pd.read_csv(FILE2)

print("=" * 80)
print("INPUT FILE 1")
print("=" * 80)
print("Shape:", df1.shape)
print("Unique physicians:", df1["physician_id"].nunique())
print("Columns:")
print(df1.columns.tolist())

print("\n" + "=" * 80)
print("INPUT FILE 2 - STATIC PHYSICIAN DATA")
print("=" * 80)
print("Shape:", df2.shape)
print("Unique physicians:", df2["physician_id"].nunique())
print("Columns:")
print(df2.columns.tolist())

# ============================================================
# 2. FILE-LEVEL DATA QUALITY CHECK
# ============================================================

print("\n" + "=" * 80)
print("FILE 1 BASIC CHECK")
print("=" * 80)

print("Rows:", len(df1))
print("Columns:", df1.shape[1])
print("Unique physicians:", df1["physician_id"].nunique())
print("Duplicate rows:", df1.duplicated().sum())

print("\nDuplicate physician-quarter combinations:")

duplicate_pq = (
    df1.groupby(
        ["physician_id", "year_quarter"]
    )
    .size()
    .reset_index(name="row_count")
)

print(
    duplicate_pq[
        duplicate_pq["row_count"] > 1
    ].shape[0]
)

print("\n" + "=" * 80)
print("FILE 2 BASIC CHECK")
print("=" * 80)

print("Rows:", len(df2))
print("Columns:", df2.shape[1])
print("Unique physicians:", df2["physician_id"].nunique())
print(
    "Duplicate physician IDs:",
    df2["physician_id"].duplicated().sum()
)

# ============================================================
# 3. CHECK WHETHER FILE 2 IS REALLY STATIC
# ============================================================

print("\n" + "=" * 80)
print("STATIC PROFILE CHECK")
print("=" * 80)

profile_cols = [
    c for c in df2.columns
    if c != "physician_id"
]

for col in profile_cols:

    unique_per_physician = (
        df2.groupby("physician_id")[col]
        .nunique(dropna=True)
    )

    changing_physicians = (
        unique_per_physician > 1
    ).sum()

    print(
        f"{col}: "
        f"{changing_physicians} physicians have "
        f"more than one value"
    )

# ============================================================
# 4. MERGE FILE 1 + FILE 2
# ============================================================

before_merge = len(df1)

df = df1.merge(
    df2,
    on="physician_id",
    how="left",
    validate="many_to_one",
    suffixes=("", "_profile")
)

after_merge = len(df)

print("\n" + "=" * 80)
print("MERGED DATASET")
print("=" * 80)

print("Rows before merge:", before_merge)
print("Rows after merge :", after_merge)
print("Columns after merge:", df.shape[1])

assert before_merge == after_merge, (
    "ERROR: Row count changed after merge. "
    "Check duplicate physician IDs in File 2."
)

print(
    "Unique physicians after merge:",
    df["physician_id"].nunique()
)

# ============================================================
# 5. BASIC DATA UNDERSTANDING
# ============================================================

print("\n" + "=" * 80)
print("OVERALL DATA UNDERSTANDING")
print("=" * 80)

print("Total observations:", len(df))
print("Total columns:", df.shape[1])
print(
    "Unique physicians:",
    df["physician_id"].nunique()
)

print(
    "Observations per physician:"
)

print(
    df.groupby("physician_id")
    .size()
    .describe()
)

# ============================================================
# 6. QUARTER PREPARATION
# ============================================================

df["year_quarter"] = (
    df["year_quarter"]
    .astype(str)
    .str.strip()
)

df["year"] = (
    df["year_quarter"]
    .str[:4]
    .astype(int)
)

df["quarter"] = (
    df["year_quarter"]
    .str[-1]
    .astype(int)
)

# Continuous quarter index
df["quarter_index"] = (
    df["year"] * 4
    + df["quarter"]
)

df = (
    df.sort_values(
        ["physician_id", "quarter_index"]
    )
    .reset_index(drop=True)
)

print("\nAvailable quarters:")
print(
    df[
        ["year_quarter", "quarter_index"]
    ]
    .drop_duplicates()
    .sort_values("quarter_index")
    .to_string(index=False)
)

# ============================================================
# 7. MISSING VALUES - COUNT + PERCENTAGE
# ============================================================

missing_summary = pd.DataFrame({
    "column": df.columns,
    "missing_count": df.isna().sum().values,
    "missing_percentage": (
        df.isna().mean().values * 100
    )
})

missing_summary = (
    missing_summary
    .sort_values(
        "missing_percentage",
        ascending=False
    )
    .reset_index(drop=True)
)

print("\n" + "=" * 80)
print("MISSING VALUE ANALYSIS")
print("=" * 80)

print(
    missing_summary.to_string(index=False)
)

# Missing-value plot
missing_plot = (
    missing_summary[
        missing_summary["missing_percentage"] > 0
    ]
)

if len(missing_plot) > 0:

    plt.figure(
        figsize=(
            10,
            max(5, len(missing_plot) * 0.35)
        )
    )

    sns.barplot(
        data=missing_plot,
        x="missing_percentage",
        y="column"
    )

    plt.title(
        "Missing Values by Column (%)"
    )
    plt.xlabel("Missing Percentage")
    plt.ylabel("Column")

    plt.tight_layout()
    plt.show()

# ============================================================
# 8. TARGET ANALYSIS
# ============================================================

TARGET = "brand_prescribed"

# Ensure target is numeric if required
if not pd.api.types.is_numeric_dtype(
    df[TARGET]
):
    mapping = {
        "yes": 1,
        "y": 1,
        "true": 1,
        "1": 1,
        "adopted": 1,
        "prescribed": 1,
        "no": 0,
        "n": 0,
        "false": 0,
        "0": 0,
        "not adopted": 0
    }

    df[TARGET] = (
        df[TARGET]
        .astype(str)
        .str.lower()
        .str.strip()
        .map(mapping)
    )

print("\n" + "=" * 80)
print("OVERALL ADOPTION")
print("=" * 80)

adopters = (df[TARGET] == 1).sum()
non_adopters = (df[TARGET] == 0).sum()
total_target = adopters + non_adopters

print("Total records:", total_target)
print("Adopter records:", adopters)
print("Non-adopter records:", non_adopters)

print(
    "Adopter %:",
    round(adopters / total_target * 100, 2)
)

print(
    "Non-adopter %:",
    round(non_adopters / total_target * 100, 2)
)

# ============================================================
# 9. OVERALL ADOPTION PERCENTAGE GRAPH
# ============================================================

overall_target_pct = pd.DataFrame({
    "Status": [
        "Adopter",
        "Non-Adopter"
    ],
    "Percentage": [
        adopters / total_target * 100,
        non_adopters / total_target * 100
    ]
})

plt.figure(figsize=(7, 5))

sns.barplot(
    data=overall_target_pct,
    x="Status",
    y="Percentage"
)

plt.title(
    "Overall Adopter vs Non-Adopter Distribution"
)
plt.ylabel("Percentage of Records")
plt.xlabel("")

for i, value in enumerate(
    overall_target_pct["Percentage"]
):
    plt.text(
        i,
        value + 1,
        f"{value:.1f}%",
        ha="center"
    )

plt.ylim(0, 100)
plt.tight_layout()
plt.show()

# ============================================================
# 10. ADOPTERS VS NON-ADOPTERS BY QUARTER
# ============================================================

quarter_summary = (
    df.groupby("year_quarter")
    .agg(
        total_records=(TARGET, "count"),
        adopters=(TARGET, "sum"),
        unique_physicians=(
            "physician_id",
            "nunique"
        )
    )
    .reset_index()
)

quarter_summary["non_adopters"] = (
    quarter_summary["total_records"]
    - quarter_summary["adopters"]
)

quarter_summary["adoption_rate"] = (
    quarter_summary["adopters"]
    / quarter_summary["total_records"]
    * 100
)

quarter_summary["non_adoption_rate"] = (
    quarter_summary["non_adopters"]
    / quarter_summary["total_records"]
    * 100
)

quarter_summary = (
    quarter_summary
    .merge(
        df[
            ["year_quarter", "quarter_index"]
        ].drop_duplicates(),
        on="year_quarter",
        how="left"
    )
    .sort_values("quarter_index")
)

print("\n" + "=" * 80)
print("QUARTERLY ADOPTION SUMMARY")
print("=" * 80)

print(
    quarter_summary[
