# ============================================================
# 26. HIGH CORRELATION PAIRS
# ============================================================

feature_corr = (
    df[numeric_business_cols]
    .corr()
)

upper = feature_corr.where(
    np.triu(
        np.ones(feature_corr.shape),
        k=1
    ).astype(bool)
)

high_corr_pairs = (
    upper.stack()
    .reset_index()
)

high_corr_pairs.columns = [
    "feature_1",
    "feature_2",
    "correlation"
]

high_corr_pairs["abs_correlation"] = (
    high_corr_pairs["correlation"].abs()
)

high_corr_pairs = (
    high_corr_pairs[
        high_corr_pairs["abs_correlation"] >= 0.70
    ]
    .sort_values(
        "abs_correlation",
        ascending=False
    )
)

print("\n" + "=" * 80)
print("HIGHLY CORRELATED FEATURE PAIRS")
print("=" * 80)

