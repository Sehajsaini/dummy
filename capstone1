        "time_index"
    ]
]

print("\nNumeric activity columns:")
print(LAG_NUMERIC)

for col in LAG_NUMERIC:

    merged[f"{col}_lag1"] = (
        merged.groupby(ID_COL)[col]
        .shift(1)
    )

    merged[f"{col}_lag2"] = (
        merged.groupby(ID_COL)[col]
        .shift(2)
    )

# ============================================================
# 11. VALIDATE LAG CONTINUITY
# ============================================================

merged["previous_time_index"] = (
    merged.groupby(ID_COL)
    ["time_index"]
    .shift(1)
)

merged["previous_previous_time_index"] = (
    merged.groupby(ID_COL)
    ["time_index"]
    .shift(2)
)

merged["lag1_contiguous"] = (
    merged["time_index"]
    - merged["previous_time_index"]
    == 1
)

merged["lag2_contiguous"] = (
    merged["time_index"]
    - merged["previous_previous_time_index"]
    == 2
)

# Invalidate lag values if there is a gap
for col in LAG_NUMERIC:

    merged.loc[
        ~merged["lag1_contiguous"],
        f"{col}_lag1"
    ] = np.nan

    merged.loc[
        ~merged["lag2_contiguous"],
        f"{col}_lag2"
    ] = np.nan

# ============================================================
# 12. CREATE NEXT-QUARTER TARGET
# ============================================================
# Business problem:
#
# Current physician is a non-adopter.
# Previous 2 quarters are used as predictors.
# Predict whether physician adopts in NEXT quarter.
#
# Example:
#
# Q8 = Lag 2
# Q9 = Lag 1
# Q10 = current source period
# Q11 = target
#
# ============================================================

next_time = (
    merged.groupby(ID_COL)
    ["time_index"]
    .shift(-1)
)

next_target = (
    merged.groupby(ID_COL)
    [TARGET_COL]
    .shift(-1)
)

merged["valid_next_quarter"] = (
    next_time
    == merged["time_index"] + 1
)

merged["target_next_qtr"] = np.where(
    merged["valid_next_quarter"],
    next_target,
    np.nan
)

# ============================================================
# 13. IDENTIFY CURRENT NON-ADOPTERS
# ============================================================

previous_adoption = (
    merged.groupby(ID_COL)[TARGET_COL]
    .cummax()
    .groupby(merged[ID_COL])
    .shift(1, fill_value=0)
)

merged["adopted_before"] = (
    previous_adoption
    .astype(int)
)

merged["is_non_adopter_now"] = (
    merged["adopted_before"] == 0
).astype(int)

# ============================================================
# 14. KEEP VALID MODELING OBSERVATIONS
# ============================================================
# We only model:
#
# 1. physician is currently non-adopter
# 2. next quarter exists
# 3. Lag 1 exists
# 4. Lag 2 exists
#
# ============================================================

model_data = merged[
    (merged["is_non_adopter_now"] == 1)
    & merged["target_next_qtr"].notna()
    & merged["lag1_contiguous"]
    & merged["lag2_contiguous"]
].copy()

model_data["target"] = (
