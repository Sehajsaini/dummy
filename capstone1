# 9. CHECK PHYSICIAN QUARTER GAPS
# ============================================================

def check_gaps(data):

    gap_records = []

    for physician, group in data.groupby(ID_COL):

        times = sorted(
            group["time_index"]
            .dropna()
            .unique()
        )

        if len(times) > 1:

            differences = np.diff(times)

            if not np.all(
                differences == 1
            ):

                gap_records.append({
                    ID_COL: physician,
                    "quarters": times,
                    "gaps": differences[
                        differences > 1
                    ].tolist()
                })

    return pd.DataFrame(gap_records)


