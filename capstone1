)

plt.title(
    "TRAIN-ONLY Numeric Correlation"
)

plt.tight_layout()
plt.show()

# ============================================================
# 24. REMOVE HIGHLY CORRELATED FEATURES
# ============================================================

upper = correlation.abs().where(
    np.triu(
        np.ones(
            correlation.shape
        ),
        k=1
    ).astype(bool)
)

# Correlation with target
target_corr = {}

for col in numeric_features:

    value = train_numeric[col].corr(
        y_train
    )

    target_corr[col] = (
        abs(value)
        if pd.notna(value)
        else 0
    )

drop_corr = set()

for col in upper.columns:

    for other in upper.index:

        if (
            pd.notna(upper.loc[other, col])
            and
            upper.loc[other, col]
            >= CORR_THRESHOLD
        ):

            # Keep the variable more associated
            # with the target.
            if (
                target_corr[col]
                >= target_corr[other]
            ):
                drop_corr.add(other)

            else:
                drop_corr.add(col)

corr_features = [
    c for c in numeric_features
    if c not in drop_corr
]

print(
    "\nRemoved because of high correlation:"
)

print(
    sorted(drop_corr)
)

print(
    "Remaining numeric features:",
    len(corr_features)
)

# ============================================================
# 25. TRAIN-ONLY VIF
# ============================================================

vif_data = train_numeric[
    corr_features
].copy()

vif_records = []

for i, col in enumerate(
    vif_data.columns
):

    try:

        value = variance_inflation_factor(
            vif_data.values,
            i
        )

    except Exception:

        value = np.inf

    vif_records.append({
        "feature": col,
        "VIF": value
    })

vif_df = (
    pd.DataFrame(vif_records)
    .sort_values(
        "VIF",
        ascending=False
    )
)

print("\n" + "=" * 80)
print("TRAIN-ONLY VIF")
print("=" * 80)

print(
    vif_df.round(3)
    .to_string(index=False)
)

high_vif_features = set(
    vif_df.loc[
        vif_df["VIF"] > VIF_THRESHOLD,
        "feature"
    ]
)

# Remove high-VIF features
# only after correlation filtering.

corr_features = [
    c for c in corr_features
    if c not in high_vif_features
]

print(
    "\nRemoved due to VIF >",
    VIF_THRESHOLD,
    ":"
)

print(
    sorted(high_vif_features)
)

# ============================================================
# 26. RANK NUMERIC FEATURES BY TRAIN TARGET ASSOCIATION
# ============================================================

ranked_numeric = sorted(
    corr_features,
    key=lambda x: target_corr.get(
        x,
        0
    ),
    reverse=True
)

selected_numeric = ranked_numeric[
    :MAX_NUMERIC_FEATURES
]

print("\nSelected numeric features:")

for i, col in enumerate(
    selected_numeric,
    1
):

    print(
        i,
        col,
        "target corr:",
        round(
            target_corr[col],
            4
        )
    )

# ============================================================
# 27. SELECT CATEGORICAL FEATURES
# ============================================================
# Select only low-cardinality meaningful categorical
# variables.
#
# High-cardinality physician identifiers are already removed.
# ============================================================

categorical_candidates = []

for col in categorical_features:

    nunique = (
        X_train_raw[col]
        .nunique(
            dropna=True
        )
    )

    if (
        2 <= nunique <= 15
    ):

        categorical_candidates.append(
            col
        )

# Rank categorical variables by
# target adoption difference.

categorical_scores = []

for col in categorical_candidates:

    temp = pd.DataFrame({
        "x": X_train_raw[col],
        "y": y_train
    })

    rate = (
        temp.groupby("x")["y"]
        .mean()
    )

    if len(rate) > 1:

        score = (
            rate.max()
            - rate.min()
        )

    else:

        score = 0

    categorical_scores.append(
        (
            col,
            score
        )
    )

categorical_scores = sorted(
    categorical_scores,
    key=lambda x: x[1],
    reverse=True
)

selected_categorical = [
    x[0]
    for x in categorical_scores[
        :MAX_CATEGORICAL_FEATURES
    ]
]

print(
    "\nSelected categorical features:"
)

print(
    selected_categorical
)

# ============================================================
# 28. FINAL FEATURE LIST
# ============================================================

FEATURES = (
    selected_numeric
    + selected_categorical
)

# Explicitly ensure gender is not present
