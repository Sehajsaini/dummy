# ============================================================
# 40. RECALL-AWARE THRESHOLD SELECTION
# ============================================================
# Threshold is selected from OOF TRAIN predictions ONLY.
#
# We maximize F2:
#   Recall receives more importance than Precision.
#
# Precision floor prevents threshold from becoming
# unrealistically low.
# ============================================================

def select_threshold(
    y_true,
    probabilities,
    min_precision=0.25
):

    thresholds = np.arange(
        0.10,
        0.71,
        0.01
    )

    records = []

    for threshold in thresholds:

        predictions = (
            probabilities >= threshold
        ).astype(int)

        precision = precision_score(
            y_true,
            predictions,
            zero_division=0
        )

        recall = recall_score(
            y_true,
            predictions,
            zero_division=0
        )

        f1 = f1_score(
            y_true,
            predictions,
            zero_division=0
        )

        # F2
        f2 = (
            5 * precision * recall
            /
            (
                4 * precision
                + recall
            )
            if (
                4 * precision
                + recall
            ) > 0
            else 0
        )

        records.append({
            "threshold": threshold,
            "precision": precision,
            "recall": recall,
            "f1": f1,
            "f2": f2
        })

    threshold_df = pd.DataFrame(
        records
    )

    eligible = threshold_df[
        threshold_df["precision"]
        >= min_precision
    ]

    if len(eligible) == 0:

        eligible = threshold_df

    best = (
        eligible
        .sort_values(
            [
                "f2",
                "recall",
                "precision"
            ],
            ascending=False
        )
        .iloc[0]
    )

    return (
        float(best["threshold"]),
        threshold_df
    )

