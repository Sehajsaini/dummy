print(
    "Numeric:",
    len(
        [
            c for c in FEATURES
            if c in selected_numeric
        ]
    )
)

print(
    "Categorical:",
    len(
        [
            c for c in FEATURES
            if c in selected_categorical
        ]
    )
)

# ============================================================
