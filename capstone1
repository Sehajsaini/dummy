def convert_binary(series):

    if pd.api.types.is_numeric_dtype(series):

        return pd.to_numeric(
            series,
            errors="coerce"
        )

    mapping = {
        "yes": 1,
        "y": 1,
        "true": 1,
        "1": 1,
        "adopted": 1,
        "prescribed": 1,
        "no": 0,
        "n": 0,
        "false": 0,
        "0": 0,
        "not adopted": 0,
        "not_prescribed": 0
    }

    return (
        series.astype(str)
        .str.strip()
        .str.lower()
        .map(mapping)
    )


