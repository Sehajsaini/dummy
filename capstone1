        y_train,
        y_test
    ],
    axis=0
)

final_model = Pipeline(
    steps=[
        (
            "preprocessor",
            make_preprocessor()
        ),

        (
            "smote",
            SMOTE(
                random_state=RANDOM_STATE,
                k_neighbors=5
            )
        ),

        (
            "model",
            create_model(
                best_model_name,
                best_params[
                    best_model_name
                ].copy()
            )
        )
    ]
)

final_model.fit(
    all_X,
    all_y
)

