# ============================================================
# 10. CREATE LAG 1 AND LAG 2
# ============================================================
# IMPORTANT:
# Lags are created on the FULL chronological panel.
# We do NOT first remove adopters/non-adopters.
#
# This ensures Lag 1 genuinely means previous quarter
# and Lag 2 genuinely means two quarters previously.

# ============================================================

LAG_NUMERIC = [
    c for c in file1.select_dtypes(
        include=np.number
    ).columns
    if c not in [
        TARGET_COL
    ]
]

# Remove ID if numeric
