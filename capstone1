def create_model(
    model_name,
    params=None
):

    params = params or {}

    if model_name == "xgboost":

        return XGBClassifier(
            **params,
            objective="binary:logistic",
            eval_metric="logloss",
            random_state=RANDOM_STATE,
            n_jobs=-1
        )

    if model_name == "lightgbm":

        return LGBMClassifier(
            **params,
            objective="binary",
            random_state=RANDOM_STATE,
            n_jobs=-1,
            verbosity=-1
        )

    raise ValueError(
        f"Unknown model: {model_name}"
    )

# ============================================================
# 34. OPTUNA OBJECTIVE
# ============================================================
# SMOTE is INSIDE the pipeline.
#
# Therefore every CV fold performs:
#
# train fold
#   -> impute
#   -> encode
#   -> SMOTE
#   -> model
#
# Validation fold NEVER gets SMOTE.
# ============================================================

def optuna_objective(
    trial,
    model_name
):

    if model_name == "xgboost":

        params = {

            "n_estimators":
                trial.suggest_int(
                    "n_estimators",
                    100,
                    300,
                    step=50
                ),

            "max_depth":
                trial.suggest_int(
                    "max_depth",
                    2,
                    5
                ),

            "learning_rate":
                trial.suggest_float(
                    "learning_rate",
                    0.03,
                    0.15,
                    log=True
                ),

            "min_child_weight":
                trial.suggest_int(
                    "min_child_weight",
                    2,
                    10
                ),

            "subsample":
                trial.suggest_float(
                    "subsample",
                    0.70,
                    0.95
                ),

            "colsample_bytree":
                trial.suggest_float(
                    "colsample_bytree",
                    0.70,
                    0.95
                ),

            "gamma":
                trial.suggest_float(
                    "gamma",
                    0,
                    2
                ),

            "reg_alpha":
                trial.suggest_float(
                    "reg_alpha",
                    1e-3,
                    2,
                    log=True
                ),

            "reg_lambda":
                trial.suggest_float(
                    "reg_lambda",
                    0.1,
                    10,
                    log=True
                )
        }

    elif model_name == "lightgbm":

        params = {

            "n_estimators":
                trial.suggest_int(
                    "n_estimators",
                    100,
                    300,
                    step=50
                ),

            "num_leaves":
                trial.suggest_int(
                    "num_leaves",
                    7,
                    31
                ),

            "max_depth":
                trial.suggest_int(
                    "max_depth",
                    2,
                    7
                ),

            "learning_rate":
                trial.suggest_float(
                    "learning_rate",
                    0.03,
                    0.15,
                    log=True
                ),

            "min_child_samples":
                trial.suggest_int(
                    "min_child_samples",
                    10,
                    50
                ),

            "subsample":
                trial.suggest_float(
                    "subsample",
                    0.70,
                    0.95
                ),

            "colsample_bytree":
                trial.suggest_float(
                    "colsample_bytree",
                    0.70,
                    0.95
                ),

            "reg_alpha":
                trial.suggest_float(
                    "reg_alpha",
                    1e-3,
                    2,
                    log=True
                ),

            "reg_lambda":
                trial.suggest_float(
                    "reg_lambda",
                    0.1,
                    10,
                    log=True
                )
        }

    else:

        raise ValueError(
            "Invalid model."
        )

    model = create_model(
        model_name,
        params
    )

    pipeline = Pipeline(
        steps=[
            (
                "preprocessor",
                make_preprocessor()
            ),

            (
                "smote",
                SMOTE(
                    random_state=RANDOM_STATE,
                    k_neighbors=5
                )
            ),

            (
                "model",
                model
            )
        ]
    )

    scores = cross_val_score(
        pipeline,
        X_train,
        y_train,
        groups=groups_train,
        cv=cv,
        scoring="average_precision",
        n_jobs=1
    )

    return scores.mean()

