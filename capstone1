def generate_oof_predictions(
    model_name
):

    oof_probability = np.zeros(
        len(X_train)
    )

    for fold, (
        train_idx,
        valid_idx
    ) in enumerate(
        cv.split(
            X_train,
            y_train,
            groups_train
        ),
        1
    ):

        X_tr = X_train.iloc[
            train_idx
        ]

        y_tr = y_train.iloc[
            train_idx
        ]

        X_va = X_train.iloc[
            valid_idx
        ]

        model = create_model(
            model_name,
            best_params[
                model_name
            ].copy()
        )

        fold_pipeline = Pipeline(
            steps=[
                (
                    "preprocessor",
                    make_preprocessor()
                ),

                (
                    "smote",
                    SMOTE(
                        random_state=RANDOM_STATE,
                        k_neighbors=5
                    )
                ),

                (
                    "model",
                    model
                )
            ]
        )

        fold_pipeline.fit(
            X_tr,
            y_tr
        )

        oof_probability[
            valid_idx
        ] = fold_pipeline.predict_proba(
            X_va
        )[:, 1]

        print(
            model_name,
            "fold",
            fold,
            "completed."
        )

    return oof_probability

