# ============================================================
# 31. PREPROCESSOR
# ============================================================
# This object is FIT only within each CV fold.
# Therefore:
#
# Median imputation -> training fold only
# One-hot encoding -> training fold only
# Scaling -> training fold only
#
# Test never influences these transformations.
# ============================================================

numeric_features = [
    c for c in FEATURES
    if c in selected_numeric
]

categorical_features = [
    c for c in FEATURES
    if c in selected_categorical
]

def make_preprocessor():

    numeric_pipeline = SkPipeline(
        steps=[
            (
                "imputer",
                SimpleImputer(
                    strategy="median"
                )
            ),
            (
                "scaler",
                StandardScaler()
            )
        ]
    )

    categorical_pipeline = SkPipeline(
        steps=[
            (
                "imputer",
                SimpleImputer(
                    strategy="most_frequent"
                )
            ),
            (
                "onehot",
                OneHotEncoder(
                    handle_unknown="ignore",
                    sparse_output=False
                )
            )
        ]
    )

    return ColumnTransformer(
        transformers=[
            (
                "num",
                numeric_pipeline,
                numeric_features
            ),
            (
                "cat",
                categorical_pipeline,
                categorical_features
            )
        ],
        remainder="drop"
    )

