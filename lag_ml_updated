# =========================================================================================
# STEP 6 : ROLLING-WINDOW (TIME-BASED) CROSS VALIDATION SPLITS
# =========================================================================================
def rolling_window_splits(df, quarter_col="target_quarter", min_train_quarters=3):
    """
    Expanding-window time series CV: for each successive target quarter Q (after an
    initial warm-up window), train on all quarters < Q, validate on quarter == Q.
    This respects chronology -> no future information ever leaks into training.
    """
    quarters = sorted(df[quarter_col].unique())
    splits = []
    for i in range(min_train_quarters, len(quarters)):
        train_quarters = quarters[:i]
        val_quarter = quarters[i]
        train_idx = df.index[df[quarter_col].isin(train_quarters)]
        val_idx = df.index[df[quarter_col] == val_quarter]
        if len(val_idx) > 0 and df.loc[val_idx, TARGET_COL].nunique() > 1:
            splits.append((train_idx, val_idx))
    return splits


# =========================================================================================
# STEP 6b : F-BETA / THRESHOLD HELPERS  (new in v2)
# =========================================================================================
def best_threshold_fbeta(y_true, proba, beta=BETA):
    """
    Scans every threshold implied by the precision-recall curve and returns the
    (threshold, fbeta_score) pair that maximizes F-beta. beta=2 weights recall twice as
    heavily as precision. Used both as a per-fold CV score (tuning) and, on pooled
    out-of-fold predictions, as the final decision threshold for a model.
    """
    y_true = np.asarray(y_true)
    proba = np.asarray(proba)
    if y_true.sum() == 0 or y_true.sum() == len(y_true):
        return 0.5, 0.0

    precisions, recalls, thresholds = precision_recall_curve(y_true, proba)
    precisions, recalls = precisions[:-1], recalls[:-1]  # align with `thresholds`
    denom = (beta ** 2) * precisions + recalls
    fbeta_scores = np.where(denom > 0, (1 + beta ** 2) * precisions * recalls / np.where(denom == 0, 1, denom), 0.0)

    if len(thresholds) == 0:
        return 0.5, 0.0
    best_idx = int(np.argmax(fbeta_scores))
    return float(thresholds[best_idx]), float(fbeta_scores[best_idx])


def get_scale_pos_weight(y):
    """neg/pos ratio, used instead of SMOTE so models train on real data only."""
    pos = max(int((y == 1).sum()), 1)
    neg = int((y == 0).sum())
    return neg / pos


def compute_oof_predictions(model_type, params, X, y, splits):
    """
    Pools out-of-fold predictions across the rolling-window CV splits. Every validation
    fold is scored by a model trained ONLY on strictly earlier quarters -> leak-free.
    Used to pick the final decision threshold without ever looking at test or Q11 data.
    """
    oof_true, oof_proba = [], []
    for train_idx, val_idx in splits:
        X_tr, y_tr = X.loc[train_idx], y.loc[train_idx]
        X_val, y_val = X.loc[val_idx], y.loc[val_idx]
        spw = get_scale_pos_weight(y_tr)

        if model_type == "xgb":
            model = xgb.XGBClassifier(**params, random_state=RANDOM_STATE, eval_metric="logloss",
                                       scale_pos_weight=spw, use_label_encoder=False)
        else:
            model = lgb.LGBMClassifier(**params, random_state=RANDOM_STATE, verbosity=-1,
                                        scale_pos_weight=spw)

        model.fit(X_tr.fillna(-999), y_tr)
        proba = model.predict_proba(X_val.fillna(-999))[:, 1]
        oof_true.append(y_val.values)
        oof_proba.append(proba)

    return np.concatenate(oof_true), np.concatenate(oof_proba)


# =========================================================================================
# STEP 7 : OPTUNA HYPERPARAMETER TUNING (XGBoost & LightGBM) - F2-FOCUSED  (changed in v2)
# =========================================================================================
def optuna_objective_factory(model_type, X, y, splits):
    def objective(trial):
        fold_scores = []
        for train_idx, val_idx in splits:
            X_tr, y_tr = X.loc[train_idx], y.loc[train_idx]
            X_val, y_val = X.loc[val_idx], y.loc[val_idx]

            # scale_pos_weight computed from the REAL fold class counts (no SMOTE -- see C1)
            spw = get_scale_pos_weight(y_tr)

            if model_type == "xgb":
                params = {
                    "n_estimators": trial.suggest_int("n_estimators", 100, 600),
                    "max_depth": trial.suggest_int("max_depth", 3, 10),
                    "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
                    "subsample": trial.suggest_float("subsample", 0.6, 1.0),
                    "colsample_bytree": trial.suggest_float("colsample_bytree", 0.6, 1.0),
                    "min_child_weight": trial.suggest_int("min_child_weight", 1, 10),
                    "reg_alpha": trial.suggest_float("reg_alpha", 1e-3, 10, log=True),
                    "reg_lambda": trial.suggest_float("reg_lambda", 1e-3, 10, log=True),
                    "random_state": RANDOM_STATE,
                    "eval_metric": "logloss",
                    "use_label_encoder": False,
                    "scale_pos_weight": spw,
                }
                model = xgb.XGBClassifier(**params)
            else:
                params = {
                    "n_estimators": trial.suggest_int("n_estimators", 100, 600),
                    "num_leaves": trial.suggest_int("num_leaves", 15, 128),
                    "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
                    "subsample": trial.suggest_float("subsample", 0.6, 1.0),
                    "colsample_bytree": trial.suggest_float("colsample_bytree", 0.6, 1.0),
                    "min_child_samples": trial.suggest_int("min_child_samples", 5, 50),
                    "reg_alpha": trial.suggest_float("reg_alpha", 1e-3, 10, log=True),
                    "reg_lambda": trial.suggest_float("reg_lambda", 1e-3, 10, log=True),
                    "random_state": RANDOM_STATE,
                    "verbosity": -1,
                    "scale_pos_weight": spw,
                }
                model = lgb.LGBMClassifier(**params)

            model.fit(X_tr.fillna(-999), y_tr)
            preds_proba = model.predict_proba(X_val.fillna(-999))[:, 1]

            # score this fold by its BEST-ACHIEVABLE F2 (i.e. we tune the model to be
            # capable of high recall at *some* sane threshold, not by mean ROC-AUC -- see C2)
            _, fold_f2 = best_threshold_fbeta(y_val, preds_proba, beta=BETA)
            fold_scores.append(fold_f2)

        return float(np.mean(fold_scores))
    return objective


def tune_model(model_type, X, y, splits, n_trials=30):
    study = optuna.create_study(direction="maximize", sampler=optuna.samplers.TPESampler(seed=RANDOM_STATE))
    study.optimize(optuna_objective_factory(model_type, X, y, splits), n_trials=n_trials, show_progress_bar=False)
    print(f"[Optuna:{model_type}] Best mean F{BETA:.0f} (CV) = {study.best_value:.4f}")
    print(f"[Optuna:{model_type}] Best params = {study.best_params}")
    return study.best_params


# =========================================================================================
# STEP 8 : FINAL MODEL TRAINING  (SMOTE removed -> scale_pos_weight, see C1)
# =========================================================================================
def fit_final_model(model_type, best_params, X_train, y_train):
    spw = get_scale_pos_weight(y_train)

    if model_type == "xgb":
        model = xgb.XGBClassifier(**best_params, random_state=RANDOM_STATE,
                                   eval_metric="logloss", use_label_encoder=False,
                                   scale_pos_weight=spw)
    else:
        model = lgb.LGBMClassifier(**best_params, random_state=RANDOM_STATE, verbosity=-1,
                                    scale_pos_weight=spw)

    model.fit(X_train.fillna(-999), y_train)
    return model


# =========================================================================================
# STEP 9 : FULL EVALUATION SUITE (classification + business metrics)
# =========================================================================================
def evaluate_model(model, X, y, dataset_name, model_name, threshold=0.5):
    proba = model.predict_proba(X.fillna(-999))[:, 1]
    preds = (proba >= threshold).astype(int)

    tn, fp, fn, tp = confusion_matrix(y, preds).ravel()
    specificity = tn / (tn + fp) if (tn + fp) > 0 else np.nan

    acc = accuracy_score(y, preds)
    prec = precision_score(y, preds, zero_division=0)
    rec = recall_score(y, preds, zero_division=0)
    f1 = f1_score(y, preds, zero_division=0)
    f_beta = fbeta_score(y, preds, beta=BETA, zero_division=0)
    roc_auc = roc_auc_score(y, proba)  # reported for reference only -- NOT used for selection
    mae = mean_absolute_error(y, proba)

    # MAPE on probability vs actual is undefined at y=0 (div by 0); use SMAPE-style business proxy instead
    nonzero_mask = y > 0
    mape = (np.abs(y[nonzero_mask] - proba[nonzero_mask]) / y[nonzero_mask]).mean() * 100 if nonzero_mask.sum() > 0 else np.nan

    # ---- business metrics: decile lift / capture rate ----
    df_rank = pd.DataFrame({"y": y.values, "proba": proba}).sort_values("proba", ascending=False)
    df_rank["decile"] = pd.qcut(df_rank["proba"].rank(method="first", ascending=False), 10, labels=False)
    overall_rate = df_rank["y"].mean()
    top_decile_rate = df_rank[df_rank["decile"] == 0]["y"].mean()
    top_decile_lift = top_decile_rate / overall_rate if overall_rate > 0 else np.nan
    top20pct_n = int(len(df_rank) * 0.2)
    top20pct_capture = df_rank.head(top20pct_n)["y"].sum() / df_rank["y"].sum() if df_rank["y"].sum() > 0 else np.nan

    n_flagged = int(preds.sum())
    pct_flagged = preds.mean()

    print(f"\n===== {model_name} | {dataset_name} | threshold={threshold:.4f} =====")
    print(f"Accuracy            : {acc:.4f}")
    print(f"Precision           : {prec:.4f}")
    print(f"Recall (Sensitivity): {rec:.4f}")
    print(f"Specificity         : {specificity:.4f}")
    print(f"F1-Score            : {f1:.4f}")
    print(f"F{BETA:.0f}-Score            : {f_beta:.4f}")
    print(f"ROC-AUC (reference) : {roc_auc:.4f}   <- not used for model/threshold selection")
    print(f"MAE (on probability): {mae:.4f}")
    print(f"MAPE (positives only): {mape:.2f}%")
    print(f"Top-decile lift     : {top_decile_lift:.2f}x  (top-decile adoption rate = {top_decile_rate:.2%} "
          f"vs overall {overall_rate:.2%})")
    print(f"Top-20% capture rate: {top20pct_capture:.2%} of all adopters found in top 20% ranked physicians")
    print(f"Flagged as positive : {n_flagged} / {len(y)}  ({pct_flagged:.2%} of population)")
    print(classification_report(y, preds, zero_division=0))

    # ROC curve
    fpr, tpr, _ = roc_curve(y, proba)
    plt.figure(figsize=(6, 5))
    plt.plot(fpr, tpr, label=f"AUC = {roc_auc:.3f}")
    plt.plot([0, 1], [0, 1], linestyle="--", color="grey")
    plt.xlabel("False Positive Rate"); plt.ylabel("True Positive Rate")
    plt.title(f"ROC Curve - {model_name} ({dataset_name})")
    plt.legend(); plt.tight_layout()
    plt.savefig(f"roc_curve_{model_name}_{dataset_name}.png", dpi=150)
    plt.close()

    # PR curve
    precision_arr, recall_arr, _ = precision_recall_curve(y, proba)
    pr_auc = auc(recall_arr, precision_arr)
    plt.figure(figsize=(6, 5))
    plt.plot(recall_arr, precision_arr, label=f"PR-AUC = {pr_auc:.3f}")
    plt.xlabel("Recall"); plt.ylabel("Precision")
    plt.title(f"Precision-Recall Curve - {model_name} ({dataset_name})")
    plt.legend(); plt.tight_layout()
    plt.savefig(f"pr_curve_{model_name}_{dataset_name}.png", dpi=150)
    plt.close()

    return {
        "accuracy": acc, "precision": prec, "recall": rec, "specificity": specificity,
        "f1": f1, "fbeta": f_beta, "roc_auc": roc_auc, "pr_auc": pr_auc, "mae": mae, "mape": mape,
        "top_decile_lift": top_decile_lift, "top20pct_capture": top20pct_capture,
        "n_flagged": n_flagged, "pct_flagged": pct_flagged,
    }


# =========================================================================================
# STEP 10 : SHAP EXPLAINABILITY
# =========================================================================================
def run_shap_analysis(model, X_train, model_name, max_display=20):
    explainer = shap.TreeExplainer(model)
    shap_values = explainer.shap_values(X_train.fillna(-999))

    plt.figure()
    shap.summary_plot(shap_values, X_train.fillna(-999), max_display=max_display, show=False)
    plt.title(f"SHAP Feature Importance - {model_name}")
    plt.tight_layout()
    plt.savefig(f"shap_summary_{model_name}.png", dpi=150)
    plt.close()
    print(f"[SHAP] Summary plot saved for {model_name}")

    mean_abs_shap = np.abs(shap_values).mean(axis=0)
    importance_df = pd.DataFrame({
        "feature": X_train.columns, "mean_abs_shap": mean_abs_shap
    }).sort_values("mean_abs_shap", ascending=False)
    return importance_df


# =========================================================================================
# STEP 11 : MAIN ORCHESTRATION
# =========================================================================================
def main():
    # ---- 1) Load ----
    file1, file2, test_phys = load_raw_data()

    # ---- 2) Ordinal encode tier BEFORE lagging ----
    file1, tier_map = encode_tier_ordinal(file1)
    print(f"[Tier] Ordinal mapping learned: {tier_map}")

    # ---- 3) Build training panel (lag features + target-quarter filtering) ----
    train_panel = build_lag_panel(file1, is_scoring=False)
    print(f"[Panel] Training panel shape: {train_panel.shape}, "
          f"positive rate: {train_panel[TARGET_COL].mean():.3%}")

    # ---- 3b) Build Q11 scoring panel for Test_physicians ----
    score_panel_full = build_lag_panel(file1, is_scoring=True)
    score_panel = score_panel_full[score_panel_full[ID_COL].isin(test_phys[ID_COL])].copy()
    print(f"[Panel] Q11 scoring panel shape: {score_panel.shape} "
          f"(expected ~{len(test_phys)} physicians)")

    # ---- 4) Merge static file2 + one-hot encode categoricals ----
    train_merged, ohe = merge_static_and_encode(train_panel, file2, fit_ohe=True)
    score_merged, _ = merge_static_and_encode(score_panel, file2, ohe=ohe, fit_ohe=False)

    # ---- 5) Train/test split (80/20, stratified on target, BEFORE further EDA fitting) ----
    feature_cols_all = [c for c in train_merged.columns if c not in NON_FEATURE_COLS]
    X_all = train_merged[feature_cols_all]
    y_all = train_merged[TARGET_COL]

    X_train, X_test, y_train, y_test, meta_train, meta_test = train_test_split(
        X_all, y_all, train_merged[[ID_COL, "target_quarter"]],
        test_size=0.20, stratify=y_all, random_state=RANDOM_STATE
    )
    train_df = pd.concat([meta_train, X_train, y_train], axis=1)
    test_df = pd.concat([meta_test, X_test, y_test], axis=1)

    # ---- 6) EDA: missingness drop (train-derived), gender mode impute, VIF, correlation ----
    train_df, test_df, dropped_missing_cols = eda_missing_value_drop(train_df, test_df, threshold=0.20)
    print(f"[EDA] '{TIER_COL}_lag1/2' likely among dropped-for-missingness columns "
          f"(early quarters lack tier history) -> confirmed above.")

    train_df, test_df = impute_gender_mode(train_df, test_df)

    numeric_feature_cols = [
        c for c in train_df.columns
        if c not in NON_FEATURE_COLS and pd.api.types.is_numeric_dtype(train_df[c])
    ]
    # simple median fill just for the VIF computation / correlation plot (does not alter
    # the actual modeling data)
    train_vif_ready = train_df.copy()
    train_vif_ready[numeric_feature_cols] = train_vif_ready[numeric_feature_cols].fillna(
        train_vif_ready[numeric_feature_cols].median()
    )

    train_df, test_df, kept_features, dropped_vif_cols = vif_reduce(
        train_df, test_df, numeric_feature_cols, vif_threshold=10.0
    )
    print(f"[VIF] Final feature count after VIF reduction: {len(kept_features)}")

    plot_correlation_heatmap(train_vif_ready, kept_features)

    # ---- align score_merged to the same final feature set ----
    for col in kept_features:
        if col not in score_merged.columns:
            score_merged[col] = np.nan
    score_final = score_merged[[ID_COL] + kept_features]

    X_train_final = train_df[kept_features]
    y_train_final = train_df[TARGET_COL]
    X_test_final = test_df[kept_features]
    y_test_final = test_df[TARGET_COL]

    # ---- 7) Rolling window CV splits (on TRAIN portion only) ----
    splits = rolling_window_splits(train_df, quarter_col="target_quarter", min_train_quarters=3)
    print(f"[CV] Built {len(splits)} rolling-window (expanding) validation folds")

    # ---- 8) Optuna tuning: XGBoost & LightGBM, objective = mean best-F2 across folds ----
    xgb_best_params = tune_model("xgb", X_train_final, y_train_final, splits, n_trials=30)
    lgb_best_params = tune_model("lgb", X_train_final, y_train_final, splits, n_trials=30)

    # ---- 9) Pick decision threshold per model from POOLED OOF predictions (leak-free) ----
    xgb_oof_true, xgb_oof_proba = compute_oof_predictions("xgb", xgb_best_params, X_train_final, y_train_final, splits)
    xgb_threshold, xgb_oof_f2 = best_threshold_fbeta(xgb_oof_true, xgb_oof_proba, beta=BETA)
    print(f"[Threshold] XGBoost  -> OOF-selected threshold = {xgb_threshold:.4f} "
          f"(OOF F{BETA:.0f} = {xgb_oof_f2:.4f})")

    lgb_oof_true, lgb_oof_proba = compute_oof_predictions("lgb", lgb_best_params, X_train_final, y_train_final, splits)
    lgb_threshold, lgb_oof_f2 = best_threshold_fbeta(lgb_oof_true, lgb_oof_proba, beta=BETA)
    print(f"[Threshold] LightGBM -> OOF-selected threshold = {lgb_threshold:.4f} "
          f"(OOF F{BETA:.0f} = {lgb_oof_f2:.4f})")

    # ---- 10) Fit final models on full train (scale_pos_weight, no resampling) ----
    xgb_model = fit_final_model("xgb", xgb_best_params, X_train_final, y_train_final)
    lgb_model = fit_final_model("lgb", lgb_best_params, X_train_final, y_train_final)

    # ---- 11) Evaluate both models on TRAIN and TEST, each at ITS OWN tuned threshold ----
    results = {}
    results[("XGBoost", "train")] = evaluate_model(xgb_model, X_train_final, y_train_final, "train", "XGBoost", threshold=xgb_threshold)
    results[("XGBoost", "test")] = evaluate_model(xgb_model, X_test_final, y_test_final, "test", "XGBoost", threshold=xgb_threshold)
    results[("LightGBM", "train")] = evaluate_model(lgb_model, X_train_final, y_train_final, "train", "LightGBM", threshold=lgb_threshold)
    results[("LightGBM", "test")] = evaluate_model(lgb_model, X_test_final, y_test_final, "test", "LightGBM", threshold=lgb_threshold)

    results_df = pd.DataFrame(results).T
    print("\n===== MODEL COMPARISON SUMMARY =====")
    print(results_df)

    # ---- 12) SHAP explainability for both models ----
    xgb_importance = run_shap_analysis(xgb_model, X_train_final, "XGBoost")
    lgb_importance = run_shap_analysis(lgb_model, X_train_final, "LightGBM")
    print("\nTop 15 features (XGBoost, SHAP):\n", xgb_importance.head(15))
    print("\nTop 15 features (LightGBM, SHAP):\n", lgb_importance.head(15))

    # ---- 13) Pick best model by TEST F-beta (NOT ROC-AUC, per business situation) ----
    xgb_test_f2 = results[("XGBoost", "test")]["fbeta"]
    lgb_test_f2 = results[("LightGBM", "test")]["fbeta"]
    if xgb_test_f2 >= lgb_test_f2:
        best_name, best_model, best_threshold = "XGBoost", xgb_model, xgb_threshold
    else:
        best_name, best_model, best_threshold = "LightGBM", lgb_model, lgb_threshold
    print(f"\n[Final] Selected best model based on TEST F{BETA:.0f}: {best_name} "
          f"(XGBoost F{BETA:.0f}={xgb_test_f2:.4f}, LightGBM F{BETA:.0f}={lgb_test_f2:.4f}), "
          f"decision threshold = {best_threshold:.4f}")

    # ---- 14) Score Test_physicians.csv for Q11 ----
    X_score = score_final[kept_features]
    score_proba = best_model.predict_proba(X_score.fillna(-999))[:, 1]
    score_class_threshold = (score_proba >= best_threshold).astype(int)

    # rank-based top-20% flag: a stable way to hit a fixed-size business target list
    # (e.g. "~250-300 out of 1502") regardless of small probability-threshold shifts
    n_top20 = int(round(len(score_proba) * 0.20))
    rank_order = np.argsort(-score_proba)
    top20_flag = np.zeros(len(score_proba), dtype=int)
    top20_flag[rank_order[:n_top20]] = 1

    output = pd.DataFrame({
        ID_COL: score_final[ID_COL],
        "adoption_probability_Q11": score_proba,
        "predicted_adoption_class_Q11": score_class_threshold,
        "top20pct_flag_Q11": top20_flag,
    }).sort_values("adoption_probability_Q11", ascending=False)

    output.to_csv(OUTPUT_SCORED_PATH, index=False)
    print(f"\n[Output] Scored file written to: {OUTPUT_SCORED_PATH}")
    print(f"[Output] Threshold-based flags : {score_class_threshold.sum()} / {len(score_class_threshold)} physicians")
    print(f"[Output] Top-20% rank flags    : {top20_flag.sum()} / {len(top20_flag)} physicians")
    print(output.head(10))

    return {
        "train_df": train_df, "test_df": test_df,
        "xgb_model": xgb_model, "lgb_model": lgb_model,
        "xgb_threshold": xgb_threshold, "lgb_threshold": lgb_threshold,
        "results_df": results_df,
        "xgb_importance": xgb_importance, "lgb_importance": lgb_importance,
        "scored_output": output,
    }


if __name__ == "__main__":
    main()
