ROLLING_MIN_TRAIN_QUARTERS = 2   # inner-CV warm-up window size within quarters 3-8

# ---- IMBALANCE / THRESHOLD CONFIG ----
FBETA_BETA = 1.5                 # >1 weights recall higher than precision
FINAL_THRESHOLD_OVERRIDE = None  # set a float to bypass auto-tuning, else None
THRESHOLD_RECENT_N_FOLDS = 3     # tune final threshold on the most recent N CV folds
TOPN_BUSINESS_FLAG = 300         # guaranteed-size candidate list, independent of threshold
VOLUME_TARGET_N = 275            # midpoint of your requested 250-300 physician range

# ---- VIF / SHAP FEATURE-SELECTION CONFIG ----
VIF_THRESHOLD = 10.0             # applied ONLY to gender/tier columns (see #2 above)
