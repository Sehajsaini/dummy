# STEP 14 : MAIN ORCHESTRATION
# =========================================================================================
def main():
    # ---- 1) Load ----
    file1, file2, test_phys = load_raw_data()

    # ---- 2) Ordinal encode tier + calendar quarter BEFORE lagging ----
    file1, tier_map = encode_tier_ordinal(file1)
    print(f"[Tier] Ordinal mapping learned: {tier_map}")
    file1, quarter_map = encode_quarter_ordinal(file1)
    print(f"[Quarter] Ordinal mapping learned: {quarter_map}")

    # ---- 3) Build training panel ----
    train_panel = build_lag_panel(file1, is_scoring=False)
    print(f"[Panel] Training panel shape: {train_panel.shape}, "
          f"positive rate: {train_panel[TARGET_COL].mean():.3%}")

    rate_by_quarter = train_panel.groupby("target_quarter")[TARGET_COL].agg(["mean", "count"])
    print(f"\n[Diagnostic] Adoption rate by target_quarter:\n{rate_by_quarter}")

    # ---- 3b) Build Q11 scoring panel for Test_physicians ----
    score_panel_full = build_lag_panel(file1, is_scoring=True)
    score_panel = score_panel_full[score_panel_full[ID_COL].isin(test_phys[ID_COL])].copy()
    print(f"[Panel] Q11 scoring panel shape: {score_panel.shape} "
          f"(expected ~{len(test_phys)} physicians)")

    # ---- 4) Merge static file2 + one-hot encode categoricals ----
    train_merged, ohe = merge_static_and_encode(train_panel, file2, fit_ohe=True)
    score_merged, _ = merge_static_and_encode(score_panel, file2, ohe=ohe, fit_ohe=False)

    # ---- 5) TIME-BASED split: train = quarters 3-8, test = quarters 9-10 ----
    # NOTE: physician_id and target_quarter are NOT dropped here - they remain as real
    # columns in train_df/test_df throughout; they are simply excluded from the feature
    # list used to fit the model (see feature_cols_all below / NON_FEATURE_COLS).
    train_df, test_df = time_based_split(train_merged)

    # ---- 6) EDA: missingness drop (lag columns protected), gender mode impute ----
    train_df, test_df, dropped_missing_cols = eda_missing_value_drop(train_df, test_df, threshold=0.20)
    train_df, test_df = impute_gender_mode(train_df, test_df)

    numeric_feature_cols = [
        c for c in train_df.columns
        if c not in NON_FEATURE_COLS and pd.api.types.is_numeric_dtype(train_df[c])
    ]

    # ---- 6b) VIF reduction RESTRICTED to gender/tier columns only ----
    vif_eligible_cols = [
        c for c in numeric_feature_cols
        if c.startswith("physician_gender_") or c.startswith(f"{TIER_COL}_")
    ]
    print(f"\n[VIF] Columns eligible for VIF-based removal (gender/tier only): {vif_eligible_cols}")
    train_df, test_df, kept_features_stage1, dropped_vif_cols = vif_reduce_restricted(
        train_df, test_df, numeric_feature_cols, vif_eligible_cols, vif_threshold=VIF_THRESHOLD
    )
    print(f"[VIF] Feature count after VIF step: {len(kept_features_stage1)} "
          f"(started with {len(numeric_feature_cols)})")
    plot_correlation_heatmap(train_df, kept_features_stage1)

    for col in kept_features_stage1:
        if col not in score_merged.columns:
            score_merged[col] = np.nan

    X_train_s1 = train_df[kept_features_stage1]
    y_train = train_df[TARGET_COL]
    X_test_s1 = test_df[kept_features_stage1]
    y_test = test_df[TARGET_COL]

    # ---- 7) Rolling window CV splits (TRAIN portion, quarters 3-8, only) ----
    splits = rolling_window_splits(train_df)
    print(f"\n[CV] Built {len(splits)} rolling-window (expanding) validation folds "
          f"within quarters {TRAIN_QUARTER_RANGE}")

    # ---- 7b) CV method comparison: rolling window vs. StratifiedKFold vs. KFold ----
    compare_cv_strategies(train_df, X_train_s1, y_train)

    # =========================================================================
    # STAGE 1: initial tuning + fit, purely to obtain SHAP importance for pruning
    # =========================================================================
    print("\n" + "=" * 60)
    print("STAGE 1: initial model (full feature set) -> SHAP importance")
    print("=" * 60)
    xgb_params_s1 = tune_model("xgb", X_train_s1, y_train, splits, n_trials=40)
    lgb_params_s1 = tune_model("lgb", X_train_s1, y_train, splits, n_trials=40)

    xgb_model_s1 = fit_final_model("xgb", xgb_params_s1, X_train_s1, y_train)
    lgb_model_s1 = fit_final_model("lgb", lgb_params_s1, X_train_s1, y_train)

    xgb_importance_s1 = run_shap_analysis(xgb_model_s1, X_train_s1, "XGBoost_Stage1")
    lgb_importance_s1 = run_shap_analysis(lgb_model_s1, X_train_s1, "LightGBM_Stage1")

    kept_features_stage2, dropped_shap_cols, shap_pct_table = select_features_by_shap(
        [xgb_importance_s1, lgb_importance_s1], min_pct=SHAP_IMPORTANCE_MIN_PCT
    )
    print(f"\n[SHAP-select] Dropping {len(dropped_shap_cols)} feature(s) - unimportant "
          f"(<{SHAP_IMPORTANCE_MIN_PCT}% of total SHAP importance) in BOTH models:")
    print(dropped_shap_cols)
    print(f"[SHAP-select] {len(kept_features_stage2)} features retained for Stage 2.")

    # =========================================================================
    # STAGE 2: final tuning + fit on the SHAP-pruned feature set
    # =========================================================================
    print("\n" + "=" * 60)
    print("STAGE 2: final model (SHAP-pruned feature set)")
    print("=" * 60)
    X_train_final = X_train_s1[kept_features_stage2]
    X_test_final = X_test_s1[kept_features_stage2]

    xgb_best_params = tune_model("xgb", X_train_final, y_train, splits, n_trials=30)
    lgb_best_params = tune_model("lgb", X_train_final, y_train, splits, n_trials=30)

    xgb_model = fit_final_model("xgb", xgb_best_params, X_train_final, y_train)
    lgb_model = fit_final_model("lgb", lgb_best_params, X_train_final, y_train)

    # ---- Out-of-fold predictions -> optimal threshold per model ----
    xgb_oof_proba, xgb_oof_y, xgb_oof_fold = get_oof_predictions("xgb", xgb_best_params, X_train_final, y_train, splits)
    lgb_oof_proba, lgb_oof_y, lgb_oof_fold = get_oof_predictions("lgb", lgb_best_params, X_train_final, y_train, splits)

    xgb_thr_pooled, xp, xr, xfb = find_best_threshold_fbeta(xgb_oof_y, xgb_oof_proba, beta=FBETA_BETA)
    lgb_thr_pooled, lp, lr, lfb = find_best_threshold_fbeta(lgb_oof_y, lgb_oof_proba, beta=FBETA_BETA)
    print(f"\n[Threshold] XGBoost  POOLED-all-quarters threshold = {xgb_thr_pooled:.3f} "
          f"(precision={xp:.3f}, recall={xr:.3f}, F{FBETA_BETA}={xfb:.3f})")
    print(f"[Threshold] LightGBM POOLED-all-quarters threshold = {lgb_thr_pooled:.3f} "
          f"(precision={lp:.3f}, recall={lr:.3f}, F{FBETA_BETA}={lfb:.3f})")

    xgb_recent_mask = xgb_oof_fold >= (xgb_oof_fold.max() - THRESHOLD_RECENT_N_FOLDS + 1)
    lgb_recent_mask = lgb_oof_fold >= (lgb_oof_fold.max() - THRESHOLD_RECENT_N_FOLDS + 1)
    xgb_threshold, xrp, xrr, xrfb = find_best_threshold_fbeta(
        xgb_oof_y[xgb_recent_mask], xgb_oof_proba[xgb_recent_mask], beta=FBETA_BETA)
    lgb_threshold, lrp, lrr, lrfb = find_best_threshold_fbeta(
        lgb_oof_y[lgb_recent_mask], lgb_oof_proba[lgb_recent_mask], beta=FBETA_BETA)
    print(f"[Threshold] XGBoost  RECENT-{THRESHOLD_RECENT_N_FOLDS}-folds threshold (PRIMARY) = "
          f"{xgb_threshold:.3f} (precision={xrp:.3f}, recall={xrr:.3f}, F{FBETA_BETA}={xrfb:.3f})")
    print(f"[Threshold] LightGBM RECENT-{THRESHOLD_RECENT_N_FOLDS}-folds threshold (PRIMARY) = "
          f"{lgb_threshold:.3f} (precision={lrp:.3f}, recall={lrr:.3f}, F{FBETA_BETA}={lrfb:.3f})")

    print_threshold_scan(xgb_oof_y, xgb_oof_proba, label="XGBoost OOF (all folds, pooled)")
    print_threshold_scan(lgb_oof_y, lgb_oof_proba, label="LightGBM OOF (all folds, pooled)")

    if FINAL_THRESHOLD_OVERRIDE is not None:
        xgb_threshold = lgb_threshold = FINAL_THRESHOLD_OVERRIDE
        print(f"\n[Threshold] Override active - using fixed threshold {FINAL_THRESHOLD_OVERRIDE}")

    # ---- Evaluate both models on TRAIN (3-8) and TEST (9-10) ----
    results = {}
    results[("XGBoost", "train")] = evaluate_model(xgb_model, X_train_final, y_train, "train(Q3-8)", "XGBoost", xgb_threshold)
    results[("XGBoost", "test")] = evaluate_model(xgb_model, X_test_final, y_test, "test(Q9-10)", "XGBoost", xgb_threshold)
    results[("LightGBM", "train")] = evaluate_model(lgb_model, X_train_final, y_train, "train(Q3-8)", "LightGBM", lgb_threshold)
    results[("LightGBM", "test")] = evaluate_model(lgb_model, X_test_final, y_test, "test(Q9-10)", "LightGBM", lgb_threshold)

    results_df = pd.DataFrame(results).T
    print("\n===== MODEL COMPARISON SUMMARY =====")
    print(results_df)

    xgb_importance_final = run_shap_analysis(xgb_model, X_train_final, "XGBoost_Final")
    lgb_importance_final = run_shap_analysis(lgb_model, X_train_final, "LightGBM_Final")
    print("\nTop 15 features (XGBoost, final):\n", xgb_importance_final.head(15))
    print("\nTop 15 features (LightGBM, final):\n", lgb_importance_final.head(15))

    # ---- Pick best model by TEST PR-AUC ----
    best_name = "XGBoost" if results[("XGBoost", "test")]["pr_auc"] >= results[("LightGBM", "test")]["pr_auc"] else "LightGBM"
    best_model = xgb_model if best_name == "XGBoost" else lgb_model
    best_threshold = xgb_threshold if best_name == "XGBoost" else lgb_threshold
    print(f"\n[Final] Selected best model based on test PR-AUC: {best_name} "
          f"(threshold = {best_threshold:.3f})")

    # ---- Score Q11 population ----
    X_score = score_merged[kept_features_stage2]
    score_proba = best_model.predict_proba(X_score)[:, 1]
    score_class_model = (score_proba >= best_threshold).astype(int)

    n_physicians = len(score_proba)
    print_scoring_threshold_scan(score_proba, n_physicians, label=f"{best_name}, Q11 scoring set")

    volume_threshold = find_volume_threshold(score_proba, VOLUME_TARGET_N)
    score_class_volume = (score_proba >= volume_threshold).astype(int)
    print(f"\n[Volume-calibrated] Threshold selecting ~{VOLUME_TARGET_N} physicians "
          f"(midpoint of your 250-300 target) = {volume_threshold:.4f} "
          f"-> actually selects {score_class_volume.sum()} physicians.")

    same_tenure_mask = train_df["target_quarter"] == train_df["target_quarter"].max()
    same_tenure_proba = best_model.predict_proba(X_train_final[same_tenure_mask])[:, 1]
    print(f"\n[Diagnostic] Mean predicted probability - Q11 scoring population: "
          f"{score_proba.mean():.4f}")
    print(f"[Diagnostic] Mean predicted probability - training rows at the SAME latest "
          f"tenure (target_quarter={train_df['target_quarter'].max()}): "
          f"{same_tenure_proba.mean():.4f}")

    output = pd.DataFrame({
        ID_COL: score_merged[ID_COL],
        "adoption_probability_Q11": score_proba,
        "predicted_adoption_class_model_threshold": score_class_model,
        "predicted_adoption_class_volume_calibrated": score_class_volume,
    }).sort_values("adoption_probability_Q11", ascending=False).reset_index(drop=True)

    output["top_N_flag"] = 0
    output.loc[output.index[:TOPN_BUSINESS_FLAG], "top_N_flag"] = 1

    output.to_csv(OUTPUT_SCORED_PATH, index=False)

    print(f"\n[Output] Scored file written to: {OUTPUT_SCORED_PATH}")
    print(f"[Output] Model-threshold ({best_threshold:.3f}) predicted positive: "
          f"{score_class_model.sum()} / {n_physicians} physicians "
          f"({score_class_model.sum()/n_physicians:.1%})")
    print(f"[Output] Volume-calibrated ({volume_threshold:.3f}) predicted positive: "
          f"{score_class_volume.sum()} / {n_physicians} physicians "
          f"({score_class_volume.sum()/n_physicians:.1%})  <- use this column for a "
          f"guaranteed ~250-300 physician list")
    print(output.head(10))

    return {
        "train_df": train_df, "test_df": test_df,
        "xgb_model": xgb_model, "lgb_model": lgb_model,
        "xgb_threshold": xgb_threshold, "lgb_threshold": lgb_threshold,
        "results_df": results_df,
        "kept_features_stage1": kept_features_stage1,
        "kept_features_stage2": kept_features_stage2,
        "dropped_shap_cols": dropped_shap_cols,
        "scored_output": output,
    }


if __name__ == "__main__":
    main()
