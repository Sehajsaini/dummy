# STEP 7 : ROLLING-WINDOW CV SPLITS (capped at CV_N_SPLITS folds, more train data per fold)
# =========================================================================================
def rolling_window_splits(df, quarter_col="target_quarter", n_splits=CV_N_SPLITS):
    """
    Uses the LAST n_splits distinct quarters (within train) as validation folds, each
    preceded by ALL earlier train quarters as training data. This keeps each fold's
    training set as large as possible (vs. an expanding window starting from 1-2 quarters),
    while still respecting chronology -- no fold ever validates on data older than what
    it trained on.
    """
    quarters = sorted(df[quarter_col].unique())
    val_quarters = quarters[-n_splits:] if len(quarters) > n_splits else quarters[1:]
    splits = []
    for vq in val_quarters:
        train_idx = df.index[df[quarter_col] < vq]
        val_idx = df.index[df[quarter_col] == vq]
        if len(train_idx) > 0 and len(val_idx) > 0 and df.loc[val_idx, TARGET_COL].nunique() > 1:
            splits.append((train_idx, val_idx))
    return splits


# =========================================================================================
# STEP 8 : OPTUNA TUNING (scale_pos_weight instead of SMOTE)
# =========================================================================================
# =========================================================================================
# STEP 7b : RECENCY-WEIGHTED SAMPLE WEIGHTS
#           Gives more recent TRAIN quarters more influence during tree fitting, without
#           discarding older quarters. This is a root-cause fix for the older-vs-newer
#           TRAIN-quarter gap seen in evaluation (older quarters showed a much higher
#           false-positive rate at a fixed threshold): instead of only correcting for it
#           after the fact via calibration, the trees themselves now weight recent,
#           more currently-relevant patterns more heavily while fitting.
# =========================================================================================
def compute_recency_weights(quarter_values, min_weight=0.6, max_weight=1.6):
    q = pd.Series(quarter_values)
    ranks = q.rank(method="dense")
    span = max(1, ranks.max() - ranks.min())
    ranks_norm = (ranks - ranks.min()) / span
    weights = min_weight + ranks_norm * (max_weight - min_weight)
    return weights.values


def optuna_objective_factory(model_type, X, y, splits, quarters=None):
    base_ratio = (y == 0).sum() / max(1, (y == 1).sum())

    def objective(trial):
        fold_scores = []
        # FIX: widened from (0.5, 2.0) - gives Optuna more room to find models with better
        # recall at the fixed 0.5 evaluation threshold, since PR-AUC alone (the CV
        # objective) doesn't directly reward recall at any specific cutoff.
        spw_multiplier = trial.suggest_float("spw_multiplier", 0.6, 3.5)
        scale_pos_weight = base_ratio * spw_multiplier

        for train_idx, val_idx in splits:
            X_tr, y_tr = X.loc[train_idx].fillna(-999), y.loc[train_idx]
            X_val, y_val = X.loc[val_idx].fillna(-999), y.loc[val_idx]
            w_tr = compute_recency_weights(quarters.loc[train_idx]) if quarters is not None else None

            if model_type == "xgb":
                params = {
                    "n_estimators": trial.suggest_int("n_estimators", 100, 500),
                    # FIX: tightened from (3, 8) - shallower trees generalize better,
                    # narrowing the train/test gap now that we're already down to ~18
                    # features (less room for a deep tree to overfit to noise).
                    "max_depth": trial.suggest_int("max_depth", 3, 6),
                    "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
                    "subsample": trial.suggest_float("subsample", 0.6, 1.0),
                    "colsample_bytree": trial.suggest_float("colsample_bytree", 0.6, 1.0),
                    # FIX: raised lower bound from 1 - requires more samples per leaf,
                    # reduces overfitting to individual rows.
                    "min_child_weight": trial.suggest_int("min_child_weight", 3, 12),
                    "reg_alpha": trial.suggest_float("reg_alpha", 1e-3, 10, log=True),
                    "reg_lambda": trial.suggest_float("reg_lambda", 1e-3, 10, log=True),
                    "scale_pos_weight": scale_pos_weight,
                    "random_state": RANDOM_STATE, "eval_metric": "aucpr",
                }
                model = xgb.XGBClassifier(**params)
            else:
                params = {
                    "n_estimators": trial.suggest_int("n_estimators", 100, 500),
                    # FIX: tightened from (15, 96) - same generalization intent as
                    # XGBoost's max_depth reduction above.
                    "num_leaves": trial.suggest_int("num_leaves", 15, 63),
                    "learning_rate": trial.suggest_float("learning_rate", 0.01, 0.3, log=True),
                    "subsample": trial.suggest_float("subsample", 0.6, 1.0),
                    "colsample_bytree": trial.suggest_float("colsample_bytree", 0.6, 1.0),
                    # FIX: raised lower bound from 5 - same regularization intent as
                    # min_child_weight above, LightGBM's equivalent knob.
                    "min_child_samples": trial.suggest_int("min_child_samples", 10, 60),
                    "reg_alpha": trial.suggest_float("reg_alpha", 1e-3, 10, log=True),
                    "reg_lambda": trial.suggest_float("reg_lambda", 1e-3, 10, log=True),
                    "scale_pos_weight": scale_pos_weight,
                    "random_state": RANDOM_STATE, "verbosity": -1,
                }
                model = lgb.LGBMClassifier(**params)

            model.fit(X_tr, y_tr, sample_weight=w_tr)
            preds = model.predict_proba(X_val)[:, 1]
            precision, recall, _ = precision_recall_curve(y_val, preds)
            fold_scores.append(auc(recall, precision))  # PR-AUC: right metric for rare-event targeting

        return float(np.mean(fold_scores))
    return objective


def tune_model(model_type, X, y, splits, n_trials=30, quarters=None):
    study = optuna.create_study(direction="maximize", sampler=optuna.samplers.TPESampler(seed=RANDOM_STATE))
    study.optimize(optuna_objective_factory(model_type, X, y, splits, quarters=quarters), n_trials=n_trials, show_progress_bar=False)
    print(f"[Optuna:{model_type}] Best PR-AUC (CV) = {study.best_value:.4f} | params = {study.best_params}")
    return study.best_params


def fit_final_model(model_type, best_params, X_train, y_train, sample_weight=None,
                     eval_set=None, early_stopping_rounds=None):
    """
    sample_weight: optional recency weights (compute_recency_weights) so recent TRAIN
    quarters influence the trees more than older ones.
    eval_set / early_stopping_rounds: optional genuinely-held-out validation data (the
    TRAIN-CALIB slice) used to stop boosting once validation performance stops improving,
    instead of always running for whatever n_estimators Optuna happened to pick. Wrapped
    in a try/except fallback since the exact early-stopping API differs across xgboost/
    lightgbm versions - if it's unavailable, this quietly falls back to a plain fit.
    """
    base_ratio = (y_train == 0).sum() / max(1, (y_train == 1).sum())
    spw = base_ratio * best_params.pop("spw_multiplier")
    Xf = X_train.fillna(-999)
    ev = None
    if eval_set is not None:
        Xv, yv = eval_set
        ev = (Xv.fillna(-999), yv)

    if model_type == "xgb":
        ctor_kwargs = dict(**best_params, scale_pos_weight=spw, random_state=RANDOM_STATE, eval_metric="aucpr")
        if ev is not None and early_stopping_rounds:
            ctor_kwargs["early_stopping_rounds"] = early_stopping_rounds
        model = xgb.XGBClassifier(**ctor_kwargs)
        try:
            if ev is not None and early_stopping_rounds:
                model.fit(Xf, y_train, sample_weight=sample_weight, eval_set=[ev], verbose=False)
            else:
                model.fit(Xf, y_train, sample_weight=sample_weight)
        except TypeError:
            model = xgb.XGBClassifier(**{k: v for k, v in ctor_kwargs.items() if k != "early_stopping_rounds"})
            model.fit(Xf, y_train, sample_weight=sample_weight)
    else:
        model = lgb.LGBMClassifier(**best_params, scale_pos_weight=spw, random_state=RANDOM_STATE, verbosity=-1)
        try:
            if ev is not None and early_stopping_rounds:
                model.fit(Xf, y_train, sample_weight=sample_weight, eval_set=[ev],
                          callbacks=[lgb.early_stopping(early_stopping_rounds, verbose=False)])
            else:
                model.fit(Xf, y_train, sample_weight=sample_weight)
        except TypeError:
            model.fit(Xf, y_train, sample_weight=sample_weight)

    return model


# =========================================================================================
# STEP 9 : SHAP-DRIVEN FEATURE PRUNING (two-stage)
# =========================================================================================
def shap_prune_features(xgb_model, lgb_model, X_train, min_pct=0.10, target_n_features=None):
    xgb_shap = np.abs(shap.TreeExplainer(xgb_model).shap_values(X_train.fillna(-999))).mean(axis=0)
    lgb_shap = np.abs(shap.TreeExplainer(lgb_model).shap_values(X_train.fillna(-999))).mean(axis=0)

    xgb_pct = xgb_shap / xgb_shap.sum() * 100
    lgb_pct = lgb_shap / lgb_shap.sum() * 100
    combined_pct = np.maximum(xgb_pct, lgb_pct)  # a feature counts if EITHER model finds it useful

    rank_df = pd.DataFrame({
        "feature": X_train.columns, "xgb_pct": xgb_pct, "lgb_pct": lgb_pct, "combined_pct": combined_pct,
    }).sort_values("combined_pct", ascending=False).reset_index(drop=True)

    print(f"[SHAP prune] Started with {X_train.shape[1]} features. Full ranking (combined = "
          f"max of XGBoost/LightGBM importance %):\n{rank_df.to_string(index=False)}")

    if target_n_features is not None:
        kept = rank_df.head(target_n_features)["feature"].tolist()
        dropped = rank_df.iloc[target_n_features:]["feature"].tolist()
        print(f"[SHAP prune] TARGET_N_FEATURES={target_n_features} -> keeping the top "
              f"{len(kept)} features by combined SHAP importance.")
    else:
        keep_mask = combined_pct >= min_pct
        kept = list(X_train.columns[keep_mask])
        dropped = list(X_train.columns[~keep_mask])
        print(f"[SHAP prune] Dropping features below {min_pct}% importance in BOTH models.")

    print(f"[SHAP prune] Dropped ({len(dropped)}): {dropped}")
    print(f"[SHAP prune] FINAL FEATURE COUNT kept for the model = {len(kept)}: {kept}")
    return kept, dropped


# =========================================================================================
# STEP 10 : PROBABILITY CALIBRATION  (fixes "threshold has to be 0.2 to get 300 physicians")
# =========================================================================================
class PlattCalibratedModel:
    """
    Minimal, version-proof Platt-scaling wrapper: fits a 1-feature logistic regression
    that maps the base model's raw predict_proba score -> a calibrated probability.
    This is exactly what CalibratedClassifierCV(method='sigmoid') does internally, but
    implemented directly here so it doesn't depend on a specific sklearn version's API
    for the 'prefit' option (which changed across sklearn releases).
    """
    def __init__(self, base_model, platt_lr):
        self.base_model = base_model
        self.platt_lr = platt_lr

    def predict_proba(self, X):
        raw = self.base_model.predict_proba(X)[:, 1].reshape(-1, 1)
        calibrated_pos = self.platt_lr.predict_proba(raw)[:, 1]
        return np.column_stack([1 - calibrated_pos, calibrated_pos])


def calibrate_model(model, X_calib, y_calib, method="sigmoid"):
    """
    Fits Platt scaling on a chronologically LATER slice of train data the base model
    never trained on (still zero leakage into test/score). `method` kept as a parameter
    for interface compatibility but only 'sigmoid' (Platt) is implemented -- the right
    default for modest sample sizes; isotonic would need far more calibration rows than
    a quarter or two of physicians typically provides.
    """
    raw_proba = model.predict_proba(X_calib.fillna(-999))[:, 1].reshape(-1, 1)
    platt_lr = LogisticRegression()
    platt_lr.fit(raw_proba, y_calib)
    return PlattCalibratedModel(model, platt_lr)


# =========================================================================================
# STEP 11 : THRESHOLD SELECTION
# =========================================================================================
def find_best_threshold_fbeta(y_true, y_proba, beta=FBETA_BETA):
    precisions, recalls, thresholds = precision_recall_curve(y_true, y_proba)
    fbetas = (1 + beta**2) * precisions * recalls / (beta**2 * precisions + recalls + 1e-12)
    best_idx = int(np.argmax(fbetas[:-1])) if len(thresholds) > 0 else 0
    thr = float(thresholds[best_idx]) if len(thresholds) > 0 else 0.5
    return thr, precisions[best_idx], recalls[best_idx], fbetas[best_idx]


def print_scoring_threshold_scan(proba, n_total, label=""):
    print(f"\n[SCORING threshold scan - {label}] predicted-positive-count out of {n_total} physicians:")
    print(f"{'thresh':>7} {'n_pred_pos':>11} {'pct':>8}")
    for t in np.arange(0.10, 0.90, 0.02):
        n = int((proba >= t).sum())
        flag = "  <-- in 250-300 target" if TARGET_COUNT_LOW <= n <= TARGET_COUNT_HIGH else ""
        print(f"{t:7.2f} {n:11d} {n/n_total:7.1%}{flag}")


def find_business_threshold(proba, target_low, target_high, band_low, band_high):
    """
    Searches thresholds within the requested [band_low, band_high] cutoff range for the
    one that lands the predicted count closest to the [target_low, target_high] range.
    Falls back to the single closest threshold anywhere if the band can't hit the target.
    """
    candidates = np.arange(band_low, band_high + 0.001, 0.005)
    best_t, best_gap, best_n = None, np.inf, None
    for t in candidates:
        n = int((proba >= t).sum())
        gap = 0 if target_low <= n <= target_high else min(abs(n - target_low), abs(n - target_high))
        if gap < best_gap:
            best_t, best_gap, best_n = t, gap, n
    return best_t, best_n


# =========================================================================================
# STEP 12 : FULL EVALUATION SUITE
# =========================================================================================
def evaluate_model(model, X, y, dataset_name, model_name, threshold=0.5, is_calibrated=False):
    Xf = X.fillna(-999) if not is_calibrated else X.fillna(-999)
    proba = model.predict_proba(Xf)[:, 1]
    preds = (proba >= threshold).astype(int)

    tn, fp, fn, tp = confusion_matrix(y, preds).ravel()
    specificity = tn / (tn + fp) if (tn + fp) > 0 else np.nan

    acc = accuracy_score(y, preds)
    prec = precision_score(y, preds, zero_division=0)
    rec = recall_score(y, preds, zero_division=0)
    f1 = f1_score(y, preds, zero_division=0)
    roc_auc = roc_auc_score(y, proba)
    mae = mean_absolute_error(y, proba)
    nonzero_mask = y > 0
    mape = (np.abs(y[nonzero_mask] - proba[nonzero_mask]) / y[nonzero_mask]).mean() * 100 if nonzero_mask.sum() > 0 else np.nan

    df_rank = pd.DataFrame({"y": y.values, "proba": proba}).sort_values("proba", ascending=False)
    df_rank["decile"] = pd.qcut(df_rank["proba"].rank(method="first", ascending=False), 10, labels=False)
    overall_rate = df_rank["y"].mean()
    top_decile_rate = df_rank[df_rank["decile"] == 0]["y"].mean()
    top_decile_lift = top_decile_rate / overall_rate if overall_rate > 0 else np.nan
    top20pct_n = int(len(df_rank) * 0.2)
    top20pct_capture = df_rank.head(top20pct_n)["y"].sum() / df_rank["y"].sum() if df_rank["y"].sum() > 0 else np.nan

    precisions_c, recalls_c, _ = precision_recall_curve(y, proba)
    pr_auc = auc(recalls_c, precisions_c)

    print(f"\n===== {model_name} | {dataset_name} (threshold={threshold:.3f}) =====")
    print(f"Accuracy: {acc:.4f} | Precision: {prec:.4f} | Recall: {rec:.4f} | Specificity: {specificity:.4f} | F1: {f1:.4f}")
    print(f"ROC-AUC: {roc_auc:.4f} | PR-AUC: {pr_auc:.4f} | MAE: {mae:.4f} | MAPE(pos only): {mape:.2f}%")
    print(f"Top-decile lift: {top_decile_lift:.2f}x | Top-20% capture: {top20pct_capture:.2%}")
    print(classification_report(y, preds, zero_division=0))

    fpr, tpr, _ = roc_curve(y, proba)
    plt.figure(figsize=(6, 5)); plt.plot(fpr, tpr, label=f"AUC={roc_auc:.3f}")
    plt.plot([0, 1], [0, 1], "--", color="grey"); plt.xlabel("FPR"); plt.ylabel("TPR")
    plt.title(f"ROC - {model_name} ({dataset_name})"); plt.legend(); plt.tight_layout()
    plt.savefig(f"roc_curve_{model_name}_{dataset_name}.png", dpi=150); plt.close()

    plt.figure(figsize=(6, 5)); plt.plot(recalls_c, precisions_c, label=f"PR-AUC={pr_auc:.3f}")
    plt.xlabel("Recall"); plt.ylabel("Precision")
    plt.title(f"PR Curve - {model_name} ({dataset_name})"); plt.legend(); plt.tight_layout()
    plt.savefig(f"pr_curve_{model_name}_{dataset_name}.png", dpi=150); plt.close()

    return {"accuracy": acc, "precision": prec, "recall": rec, "specificity": specificity,
            "f1": f1, "roc_auc": roc_auc, "pr_auc": pr_auc, "mae": mae, "mape": mape,
            "top_decile_lift": top_decile_lift, "top20pct_capture": top20pct_capture}


# =========================================================================================
# STEP 13 : MAIN ORCHESTRATION
# =========================================================================================
def main():
    file1, file2, test_phys = load_raw_data()
    file1, tier_map = encode_tier_ordinal(file1)
    print(f"[Tier] Ordinal mapping learned: {tier_map}")

    train_panel_full = build_training_panel(file1)
    score_panel = build_scoring_panel(file1, SCORE_QUARTER, test_phys[ID_COL])
    print(f"[Panel] Full modeling panel shape: {train_panel_full.shape}")
    print(f"[Panel] Q11 ({SCORE_QUARTER}) scoring panel shape: {score_panel.shape} (expected ~{len(test_phys)})")

    # ---- Diagnostic: adoption rate by calendar quarter (explains train-vs-test differences) ----
    adopt_by_q = train_panel_full.groupby("target_quarter")[TARGET_COL].agg(["mean", "count"])
    print("\n[Diagnostic] Adoption rate by calendar target_quarter:\n", adopt_by_q)
    print(f"[Diagnostic] TRAIN={TRAIN_QUARTER_START}-{TRAIN_QUARTER_END}, "
          f"TEST={TEST_QUARTER_START}-{TEST_QUARTER_END}, SCORE={SCORE_QUARTER} "
          f"-- confirm these all appear (or, for SCORE, correctly do NOT appear) above.")

    # ---- Time-based split (no leakage across quarters) ----
    train_panel, test_panel = time_based_split(train_panel_full)

    # ---- Merge static + one-hot encode ----
    train_merged, ohe = merge_static_and_encode(train_panel, file2, fit_ohe=True)
    test_merged, _ = merge_static_and_encode(test_panel, file2, ohe=ohe, fit_ohe=False)
    score_merged, _ = merge_static_and_encode(score_panel, file2, ohe=ohe, fit_ohe=False)

    # ---- EDA (all decisions learned on TRAIN only) ----
    train_merged, test_merged, dropped_missing = eda_missing_value_drop(train_merged, test_merged, threshold=0.20)
    train_merged, test_merged = impute_gender_mode(train_merged, test_merged)
    train_merged, test_merged, dropped_vif = vif_reduce_demographics_only(train_merged, test_merged, VIF_THRESHOLD)

    numeric_cols_for_corr = [c for c in train_merged.columns if c not in NON_FEATURE_COLS and pd.api.types.is_numeric_dtype(train_merged[c])]
    print(f"[Feature funnel] After VIF (gender/tier only) + missingness drop: {len(numeric_cols_for_corr)} candidate features")
    plot_correlation_heatmap(train_merged, numeric_cols_for_corr)

    for col in numeric_cols_for_corr:
        if col not in score_merged.columns:
            score_merged[col] = np.nan
    score_merged = score_merged[[ID_COL] + [c for c in numeric_cols_for_corr if c in score_merged.columns]]

    feature_cols_stage1 = numeric_cols_for_corr
    X_train_full, y_train = train_merged[feature_cols_stage1], train_merged[TARGET_COL]
    X_test_full, y_test = test_merged[feature_cols_stage1], test_merged[TARGET_COL]

    # ---- Reserve a genuinely held-out TRAIN-CALIB slice (most recent TRAIN quarters) BEFORE
    # any tree fitting happens. Previously the calibration slice was a SUBSET of the exact
    # same rows the base model was already fit on (in-sample) - that likely overstated how
    # well-calibrated the model actually was on genuinely new data, and contributed to the
    # train/test specificity gap. Now it's held out throughout: never touched by CV tuning,
    # SHAP importance, or final tree fitting - used only for Platt scaling, early stopping,
    # and as the model-selection metric (replacing TEST PR-AUC, so TEST stays an unbiased
    # final check rather than being used to pick which model "wins").
    train_quarters_sorted = sorted(train_merged["target_quarter"].unique())
    n_base = max(1, int(len(train_quarters_sorted) * 0.8))
    base_quarters, calib_quarters = train_quarters_sorted[:n_base], train_quarters_sorted[n_base:]
    base_mask = train_merged["target_quarter"].isin(base_quarters)
    calib_mask = train_merged["target_quarter"].isin(calib_quarters)
    use_calib = calib_mask.sum() > 30 and train_merged.loc[calib_mask, TARGET_COL].nunique() > 1
    if not use_calib:
        base_mask = pd.Series(True, index=train_merged.index)
        calib_mask = pd.Series(False, index=train_merged.index)
        print("[Split] Not enough held-out quarter data to reserve a calibration slice; "
              "using all of TRAIN for fitting and skipping calibration/early stopping.")
    print(f"[Split] TRAIN-BASE (fits trees) -> {int(base_mask.sum())} rows"
          + (f" (quarters {base_quarters})" if use_calib else ""))
    if use_calib:
        print(f"[Split] TRAIN-CALIB (held out from tree fitting - Platt scaling, early stopping, "
              f"model selection, threshold reference) -> {int(calib_mask.sum())} rows (quarters {calib_quarters})")

    quarters_all = train_merged["target_quarter"]
    X_train_base_full = X_train_full[base_mask]
    y_train_base = y_train[base_mask]
    quarters_base = quarters_all[base_mask]

    # ---- Rolling-window CV on TRAIN-BASE only, capped at CV_N_SPLITS folds ----
    splits = rolling_window_splits(train_merged[base_mask], "target_quarter", n_splits=CV_N_SPLITS)
    print(f"[CV] Built {len(splits)} rolling-window folds on TRAIN-BASE, capped at CV_N_SPLITS={CV_N_SPLITS}")

    # ---- STAGE 1: tune + fit on full feature set (TRAIN-BASE only), get SHAP importance ----
    xgb_params_1 = tune_model("xgb", X_train_base_full, y_train_base, splits, n_trials=25, quarters=quarters_base)
    lgb_params_1 = tune_model("lgb", X_train_base_full, y_train_base, splits, n_trials=25, quarters=quarters_base)
    w_base_1 = compute_recency_weights(quarters_base)
    xgb_model_1 = fit_final_model("xgb", dict(xgb_params_1), X_train_base_full, y_train_base, sample_weight=w_base_1)
    lgb_model_1 = fit_final_model("lgb", dict(lgb_params_1), X_train_base_full, y_train_base, sample_weight=w_base_1)

    kept_features, dropped_shap = shap_prune_features(
        xgb_model_1, lgb_model_1, X_train_base_full, SHAP_IMPORTANCE_MIN_PCT, target_n_features=TARGET_N_FEATURES
    )

    # ---- STAGE 2: re-tune + re-fit on pruned feature set (TRAIN-BASE only) ----
    X_train_base = train_merged.loc[base_mask, kept_features]
    X_test = test_merged[kept_features]
    X_train = train_merged[kept_features]  # full TRAIN (base+calib) - used only for the "train" reporting row
    X_train_calib = train_merged.loc[calib_mask, kept_features] if use_calib else None
    y_train_calib = y_train[calib_mask] if use_calib else None

    X_score = score_merged[[c for c in kept_features if c in score_merged.columns]]
    for c in kept_features:
        if c not in X_score.columns:
            X_score[c] = np.nan
    X_score = X_score[kept_features]

    xgb_params_2 = tune_model("xgb", X_train_base, y_train_base, splits, n_trials=25, quarters=quarters_base)
    lgb_params_2 = tune_model("lgb", X_train_base, y_train_base, splits, n_trials=25, quarters=quarters_base)
    w_base_2 = compute_recency_weights(quarters_base)

    eval_set = (X_train_calib, y_train_calib) if use_calib else None
    xgb_model = fit_final_model("xgb", dict(xgb_params_2), X_train_base, y_train_base,
                                 sample_weight=w_base_2, eval_set=eval_set, early_stopping_rounds=30)
    lgb_model = fit_final_model("lgb", dict(lgb_params_2), X_train_base, y_train_base,
                                 sample_weight=w_base_2, eval_set=eval_set, early_stopping_rounds=30)

    # ---- Probability calibration: fit on TRAIN-CALIB, which the trees above never saw ----
    if use_calib:
        X_calib, y_calib = X_train_calib, y_train_calib
        xgb_model_cal = calibrate_model(xgb_model, X_calib, y_calib, method="sigmoid")
        lgb_model_cal = calibrate_model(lgb_model, X_calib, y_calib, method="sigmoid")
    else:
        print("[Calibration] Skipped (no held-out calibration slice available); using raw model probabilities.")
        xgb_model_cal, lgb_model_cal = xgb_model, lgb_model

    # ---- Threshold tuning + model-selection metric, computed on TRAIN-CALIB (genuinely
    # held out from tree fitting), not TEST. ----
    if use_calib:
        xgb_calib_proba = xgb_model_cal.predict_proba(X_calib.fillna(-999))[:, 1]
        lgb_calib_proba = lgb_model_cal.predict_proba(X_calib.fillna(-999))[:, 1]
        y_for_thr = y_calib
    else:
        xgb_calib_proba = xgb_model.predict_proba(X_train_base.fillna(-999))[:, 1]
        lgb_calib_proba = lgb_model.predict_proba(X_train_base.fillna(-999))[:, 1]
        y_for_thr = y_train_base

    xgb_threshold, xp, xr, xfb = find_best_threshold_fbeta(y_for_thr, xgb_calib_proba)
    lgb_threshold, lp, lr, lfb = find_best_threshold_fbeta(y_for_thr, lgb_calib_proba)
    print(f"\n[Threshold] XGBoost statistically-tuned threshold (REFERENCE ONLY)  = {xgb_threshold:.3f} "
          f"(P={xp:.3f}, R={xr:.3f}, F{FBETA_BETA}={xfb:.3f})")
    print(f"[Threshold] LightGBM statistically-tuned threshold (REFERENCE ONLY) = {lgb_threshold:.3f} "
          f"(P={lp:.3f}, R={lr:.3f}, F{FBETA_BETA}={lfb:.3f})")
    print(f"[Threshold] PRIMARY threshold used for all evaluation and scoring below = "
          f"EVAL_THRESHOLD = {EVAL_THRESHOLD:.2f} (fixed, calibrated - see CONFIG note above)")

    xgb_cal_prec, xgb_cal_rec, _ = precision_recall_curve(y_for_thr, xgb_calib_proba)
    xgb_calib_prauc = auc(xgb_cal_rec, xgb_cal_prec)
    lgb_cal_prec, lgb_cal_rec, _ = precision_recall_curve(y_for_thr, lgb_calib_proba)
    lgb_calib_prauc = auc(lgb_cal_rec, lgb_cal_prec)
    print(f"[Model selection] TRAIN-CALIB PR-AUC (held out from tree fitting): "
          f"XGBoost={xgb_calib_prauc:.4f}, LightGBM={lgb_calib_prauc:.4f}")

    # ---- Evaluate on TRAIN (full, base+calib) and TEST at the FIXED calibrated threshold (0.5) ----
    results = {}
    results[("XGBoost", "train")] = evaluate_model(xgb_model_cal, X_train, y_train, "train", "XGBoost", EVAL_THRESHOLD, is_calibrated=True)
    results[("XGBoost", "test")] = evaluate_model(xgb_model_cal, X_test, y_test, "test", "XGBoost", EVAL_THRESHOLD, is_calibrated=True)
    results[("LightGBM", "train")] = evaluate_model(lgb_model_cal, X_train, y_train, "train", "LightGBM", EVAL_THRESHOLD, is_calibrated=True)
    results[("LightGBM", "test")] = evaluate_model(lgb_model_cal, X_test, y_test, "test", "LightGBM", EVAL_THRESHOLD, is_calibrated=True)
    results_df = pd.DataFrame(results).T
    print("\n===== MODEL COMPARISON SUMMARY (threshold = 0.5 for all rows) =====\n", results_df)

    # ---- Diagnostic: explains any "test looks better than train on some metrics" pattern ----
    # This is normal out-of-time evaluation behavior, not a bug: TRAIN and TEST cover
    # different calendar quarters, and if their true adoption rates differ, a single FIXED
    # threshold will naturally shift precision/specificity/accuracy in one direction and
    # recall in the other. Higher TRAIN recall than TEST recall (if you see that) is the
    # expected generalization gap; better TEST precision/specificity/accuracy usually just
    # reflects a different (often lower) positive rate in the test quarters. Compare the
    # two rates below - and the full breakdown further up in [Diagnostic] Adoption rate by
    # calendar target_quarter - to confirm which effect you're looking at.
    print(f"\n[Diagnostic] TRAIN overall adoption rate = {y_train.mean():.3%}  |  "
          f"TEST overall adoption rate = {y_test.mean():.3%}")
    print("[Diagnostic] A gap here, combined with one fixed decision threshold applied to "
          "both, fully explains metrics moving in different directions between train and "
          "test - it does not indicate a leakage or code bug.")

    xgb_importance = pd.DataFrame({"feature": X_train_base.columns,
                                    "mean_abs_shap": np.abs(shap.TreeExplainer(xgb_model).shap_values(X_train_base.fillna(-999))).mean(axis=0)}
                                   ).sort_values("mean_abs_shap", ascending=False)
    lgb_importance = pd.DataFrame({"feature": X_train_base.columns,
                                    "mean_abs_shap": np.abs(shap.TreeExplainer(lgb_model).shap_values(X_train_base.fillna(-999))).mean(axis=0)}
                                   ).sort_values("mean_abs_shap", ascending=False)
    print("\nTop 15 features (XGBoost, final):\n", xgb_importance.head(15))
    print("\nTop 15 features (LightGBM, final):\n", lgb_importance.head(15))

    # ---- Select best model by TRAIN-CALIB PR-AUC (held out from tree fitting), NOT TEST.
    # Using TEST for both model selection and final reporting would make TEST an
    # optimistically-biased final check; this keeps it honest. ----
    best_name = "XGBoost" if xgb_calib_prauc >= lgb_calib_prauc else "LightGBM"
    best_model = xgb_model_cal if best_name == "XGBoost" else lgb_model_cal
    stat_threshold = xgb_threshold if best_name == "XGBoost" else lgb_threshold
    print(f"\n[Final] Selected best model based on held-out TRAIN-CALIB PR-AUC: {best_name}")
    print(f"[Final] (TEST PR-AUC - XGBoost={results[('XGBoost','test')]['pr_auc']:.4f}, "
          f"LightGBM={results[('LightGBM','test')]['pr_auc']:.4f} - shown for reference only; "
          f"not used to pick the model, so TEST stays an unbiased final check.)")

    # ---- Score Q11 population: best single model AND a simple ensemble average ----
    xgb_score_proba = xgb_model_cal.predict_proba(X_score.fillna(-999))[:, 1]
    lgb_score_proba = lgb_model_cal.predict_proba(X_score.fillna(-999))[:, 1]
    ensemble_proba = (xgb_score_proba + lgb_score_proba) / 2
    score_proba = xgb_score_proba if best_name == "XGBoost" else lgb_score_proba
    n_physicians = len(score_proba)

    print_scoring_threshold_scan(score_proba, n_physicians, label=f"{best_name} (best single model), Q11 scoring set")
    print_scoring_threshold_scan(ensemble_proba, n_physicians, label="XGBoost+LightGBM ensemble average, Q11 scoring set")

    n_at_eval_threshold = int((score_proba >= EVAL_THRESHOLD).sum())
    n_ensemble_at_eval = int((ensemble_proba >= EVAL_THRESHOLD).sum())
    print(f"\n[PRIMARY] At EVAL_THRESHOLD={EVAL_THRESHOLD:.2f}: {n_at_eval_threshold} / {n_physicians} "
          f"physicians predicted to adopt in Q11 (best single model, "
          f"{'in' if TARGET_COUNT_LOW <= n_at_eval_threshold <= TARGET_COUNT_HIGH else 'NOT in'} "
          f"your {TARGET_COUNT_LOW}-{TARGET_COUNT_HIGH} target range) - this is the column to use.")
    print(f"[Ensemble] At EVAL_THRESHOLD={EVAL_THRESHOLD:.2f}: {n_ensemble_at_eval} / {n_physicians} "
          f"physicians (ensemble average, reference/robustness check).")

    business_threshold, business_n = find_business_threshold(
        score_proba, TARGET_COUNT_LOW, TARGET_COUNT_HIGH, TARGET_THRESHOLD_LOW, TARGET_THRESHOLD_HIGH
    )
    print(f"[Reference] Closest cutoff within [{TARGET_THRESHOLD_LOW}, {TARGET_THRESHOLD_HIGH}] to the exact "
          f"target band = {business_threshold:.3f} -> selects {business_n} physicians (reference only).")

    score_class_05 = (score_proba >= EVAL_THRESHOLD).astype(int)          # PRIMARY
    score_class_stat = (score_proba >= stat_threshold).astype(int)         # reference
    score_class_business = (score_proba >= business_threshold).astype(int)  # reference
    ensemble_class_05 = (ensemble_proba >= EVAL_THRESHOLD).astype(int)      # reference/robustness

    # ---- Diagnostic: does the scoring population look structurally different to the model? ----
    same_tenure_mask = train_merged["target_quarter"] == train_merged["target_quarter"].max()
    same_tenure_proba = best_model.predict_proba(X_train[same_tenure_mask].fillna(-999))[:, 1]
    print(f"\n[Diagnostic] Mean calibrated probability - Q11 scoring population: {score_proba.mean():.4f}")
    print(f"[Diagnostic] Mean calibrated probability - training rows at same latest quarter "
          f"(target_quarter={train_merged['target_quarter'].max()}): {same_tenure_proba.mean():.4f}")

    output = pd.DataFrame({
        ID_COL: score_merged[ID_COL],
        "adoption_probability_Q11_calibrated": score_proba,
        "adoption_probability_Q11_ensemble": ensemble_proba,
        "predicted_adoption_class_Q11": score_class_05,                    # PRIMARY - use this
        "predicted_adoption_class_Q11_ensemble": ensemble_class_05,
        "predicted_adoption_class_stat_threshold_reference": score_class_stat,
        "predicted_adoption_class_business_band_reference": score_class_business,
    }).sort_values("adoption_probability_Q11_calibrated", ascending=False).reset_index(drop=True)
    output["adoption_rank"] = np.arange(1, len(output) + 1)

    output.to_csv(OUTPUT_SCORED_PATH, index=False)
    print(f"\n[Output] Scored file written to: {OUTPUT_SCORED_PATH}")
    print(f"[Output] PRIMARY column 'predicted_adoption_class_Q11' (threshold=0.5): "
          f"{score_class_05.sum()} / {n_physicians} physicians <- use this column")
    print(output.head(10))

    return {
        "train_merged": train_merged, "test_merged": test_merged,
        "xgb_model": xgb_model_cal, "lgb_model": lgb_model_cal,
        "kept_features": kept_features, "dropped_shap": dropped_shap,
        "results_df": results_df, "scored_output": output,
        "business_threshold": business_threshold,
    }


if __name__ == "__main__":
    main()
